    PRINT "Software Version: FlashPro v6.2";
    NOT_FP62:
    IF ( ! (TMPINT==FP84) ) THEN GOTO NOT_FP84;
    PRINT "Software Version: FlashPro v8.4";
    NOT_FP84:
