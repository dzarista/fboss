    SEC_UL[53..51] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_USERCODE[29..27] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 22;
