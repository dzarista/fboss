    IF ( ! (TMPINT==FP_12_2) ) THEN GOTO NOT_FP_12_2;
    PRINT "Software Version: 12.2";
    NOT_FP_12_2:
    IF ( ! (TMPINT==FP_12_3) ) THEN GOTO NOT_FP_12_3;
