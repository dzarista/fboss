# FAN I2C SENSORS
SUBSYSTEM=="hwmon", ATTR{name}=="oasis_cpld0", DEVPATH=="*/0000:07:00.0/scm-smbus.1/i2c-*/*-0060/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/FAN_CPLD0"
SUBSYSTEM=="hwmon", ATTR{name}=="oasis_cpld1", DEVPATH=="*/0000:07:00.0/scm-smbus.1/i2c-*/*-0061/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/FAN_CPLD1"
SUBSYSTEM=="hwmon", ATTR{name}=="oasis_cpld2", DEVPATH=="*/0000:07:00.0/scm-smbus.1/i2c-*/*-0062/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/FAN_CPLD2"
SUBSYSTEM=="hwmon", ATTR{name}=="tmp75", ATTRS{name}=="SCD 0000:07:00.0 SMBus master 1 bus 3", DEVPATH=="*/0000:07:00.0/scm-smbus.1/i2c-*/*-0048/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/FAN0_TMP75"
SUBSYSTEM=="hwmon", ATTR{name}=="tmp75", ATTRS{name}=="SCD 0000:07:00.0 SMBus master 1 bus 3", DEVPATH=="*/0000:07:00.0/scm-smbus.1/i2c-*/*-0049/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/FAN1_TMP75"
SUBSYSTEM=="hwmon", ATTR{name}=="tmp75", ATTRS{name}=="SCD 0000:07:00.0 SMBus master 1 bus 3", DEVPATH=="*/0000:07:00.0/scm-smbus.1/i2c-*/*-004a/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/FAN2_TMP75"
SUBSYSTEM=="i2c", ATTR{name}=="SCD 0000:07:00.0 SMBus master 1 bus 3", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0048 || echo tmp75 0x48 > /sys/bus/i2c/devices/i2c-%n/new_device'", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0049 || echo tmp75 0x49 > /sys/bus/i2c/devices/i2c-%n/new_device'", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-004a || echo tmp75 0x4a > /sys/bus/i2c/devices/i2c-%n/new_device'", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0060 || echo oasis_cpld0 0x60 > /sys/bus/i2c/devices/i2c-%n/new_device'", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0061 || echo oasis_cpld1 0x61 > /sys/bus/i2c/devices/i2c-%n/new_device'", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0062 || echo oasis_cpld2 0x62 > /sys/bus/i2c/devices/i2c-%n/new_device'"

# PSU SENSORS
SUBSYSTEM=="hwmon", SUBSYSTEMS=="i2c", ATTR{name}=="pmbus", ATTRS{name}=="SCD 0000:04:00.0 SMBus master 4 bus 0", DEVPATH=="*/0000:04:00.0/smb-scd3-smbus.4/i2c-*/*-0058/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/PSU1_PMBUS"
SUBSYSTEM=="hwmon", SUBSYSTEMS=="i2c", ATTR{name}=="pmbus", ATTRS{name}=="SCD 0000:03:00.0 SMBus master 4 bus 0", DEVPATH=="*/0000:03:00.0/smb-scd2-smbus.4/i2c-*/*-0058/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/PSU2_PMBUS"
SUBSYSTEM=="hwmon", SUBSYSTEMS=="i2c", ATTR{name}=="pmbus", ATTRS{name}=="SCD 0000:04:00.0 SMBus master 4 bus 1", DEVPATH=="*/0000:04:00.0/smb-scd3-smbus.4/i2c-*/*-0058/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/PSU3_PMBUS"
SUBSYSTEM=="hwmon", SUBSYSTEMS=="i2c", ATTR{name}=="pmbus", ATTRS{name}=="SCD 0000:03:00.0 SMBus master 4 bus 1", DEVPATH=="*/0000:03:00.0/smb-scd2-smbus.4/i2c-*/*-0058/*", RUN+="/bin/mkdir -p /run/devmap/sensors", RUN+="/bin/ln -sf %S/class/hwmon/hwmon%n /run/devmap/sensors/PSU4_PMBUS"
SUBSYSTEM=="i2c", ATTR{name}=="SCD 0000:04:00.0 SMBus master 4 bus 0", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0058 || echo pmbus 0x58 > /sys/bus/i2c/devices/i2c-%n/new_device'"
SUBSYSTEM=="i2c", ATTR{name}=="SCD 0000:03:00.0 SMBus master 4 bus 0", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0058 || echo pmbus 0x58 > /sys/bus/i2c/devices/i2c-%n/new_device'"
SUBSYSTEM=="i2c", ATTR{name}=="SCD 0000:04:00.0 SMBus master 4 bus 1", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0058 || echo pmbus 0x58 > /sys/bus/i2c/devices/i2c-%n/new_device'"
SUBSYSTEM=="i2c", ATTR{name}=="SCD 0000:03:00.0 SMBus master 4 bus 1", RUN+="/bin/sh -c 'test -d /sys/bus/i2c/devices/i2c-%n/%n-0058 || echo pmbus 0x58 > /sys/bus/i2c/devices/i2c-%n/new_device'"

# Cleanup
SUBSYSTEM=="pci", ACTION=="remove", RUN+="/bin/sh -c 'find /run/devmap/fpgas/ -xtype l -delete'"
SUBSYSTEM=="i2c", ACTION=="remove", RUN+="/bin/sh -c 'find /run/devmap/i2c-busses/ -xtype l -delete'", RUN+="/bin/sh -c 'find /run/devmap/eeproms/ -xtype l -delete'", RUN+="/bin/sh -c 'find /run/devmap/cplds/ -xtype l -delete'"
SUBSYSTEM=="hwmon", ACTION=="remove", RUN+="/bin/sh -c 'find /run/devmap/sensors/ -xtype l -delete'"
