    IF ( ! (TMPINT==FP_11_8) ) THEN GOTO NOT_11_8;
    PRINT "Software Version: 11.8";
    NOT_11_8:
    IF ( ! (TMPINT==FP_11_9) ) THEN GOTO NOT_FP_11_9;
