    NOT_MICROSEMI_IHP:
    IF ( ! (TMPINT==FP3) ) THEN GOTO NOT_FP3;
    PRINT "Programmer: FlashPro3";
    NOT_FP3:
    IF ( ! (TMPINT==FP4) ) THEN GOTO NOT_FP4;
    PRINT "Programmer: FlashPro4";
    NOT_FP4:
    IF ( ! (TMPINT==FP5) ) THEN GOTO NOT_FP5;
    PRINT "Programmer: FlashPro5";
    NOT_FP5:
