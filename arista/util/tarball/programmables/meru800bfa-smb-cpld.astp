    NOT_SCULPTW:
    IF ( ! (TMPINT==BPWIN) ) THEN GOTO NOT_BPW;
    PRINT "Programmer: BP Programmer";
    NOT_BPW:
    IF ( ! (TMPINT==MICROSEMI_IHP) ) THEN GOTO NOT_MICROSEMI_IHP;
