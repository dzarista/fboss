PROCEDURE DO_READ_CERTIFICATE USES GV,CONSTBLOCK,DO_EXIT,READ_SHARED_BUFFER;
    PASS = 0;
    BOOLEAN READ_CERT_RESULT[8];
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a2;
    WAIT IDLE, 1 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_CERT_RESULT[7..0];
        IF ( ! (READ_CERT_RESULT[7]==0) ) THEN GOTO READ_CERT_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_CERT_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_CERT_DONE;
        IRSCAN 8, $a2;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_CERT_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! ( (ACTIONTYPE==ACTION_READ_DEV_CERT)&&(PASS==0)) ) THEN GOTO READ_CERT_PASSED;
    PRINT "Failed to read device certificate, device is busy";
    STATUS = -38;
    UNIQUEEXITCODE = 32852;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    READ_CERT_PASSED:
    IF ( ! (READ_CERT_RESULT[0]==1) ) THEN GOTO READ_CERT_INVALID;
    IBLOCKS = 48;
    CALL READ_SHARED_BUFFER;
    IF ( ! (DUMPDEVCERTINFO==1) ) THEN GOTO DONTDISPLAY;
    IF ( ! (SHARED_BUFFER[4472]==1) ) THEN GOTO NOTSF2PART;
    PRINT "Family: SmartFusion2";
    NOTSF2PART:
    IF ( ! (SHARED_BUFFER[4472]==0) ) THEN GOTO NOTIGLOO2PART;
    PRINT "Family: Igloo2";
    NOTIGLOO2PART:
    PRINT "Product: ",CHR$(INT(SHARED_BUFFER[1567..1560])),CHR$(INT(SHARED_BUFFER[1575..1568]))
        ,CHR$(INT(SHARED_BUFFER[1583..1576])),CHR$(INT(SHARED_BUFFER[1591..1584]))
        ,CHR$(INT(SHARED_BUFFER[1599..1592])),CHR$(INT(SHARED_BUFFER[1607..1600]))
        ,CHR$(INT(SHARED_BUFFER[1615..1608])),CHR$(INT(SHARED_BUFFER[1623..1616]))
        ,CHR$(INT(SHARED_BUFFER[1631..1624])),CHR$(INT(SHARED_BUFFER[1639..1632]))
        ,CHR$(INT(SHARED_BUFFER[1647..1640])),CHR$(INT(SHARED_BUFFER[1655..1648]))
        ,CHR$(INT(SHARED_BUFFER[1663..1656])),CHR$(INT(SHARED_BUFFER[1671..1664]))
        ,CHR$(INT(SHARED_BUFFER[1679..1672])),CHR$(INT(SHARED_BUFFER[1687..1680]))
        ,CHR$(INT(SHARED_BUFFER[1695..1688])),CHR$(INT(SHARED_BUFFER[1703..1696]))
        ,CHR$(INT(SHARED_BUFFER[1711..1704])),CHR$(INT(SHARED_BUFFER[1719..1712]))
        ,CHR$(INT(SHARED_BUFFER[1727..1720])),CHR$(INT(SHARED_BUFFER[1735..1728]))
        ,CHR$(INT(SHARED_BUFFER[1743..1736])),CHR$(INT(SHARED_BUFFER[1751..1744]))
        ,CHR$(INT(SHARED_BUFFER[1759..1752])),CHR$(INT(SHARED_BUFFER[1767..1760]))
        ,CHR$(INT(SHARED_BUFFER[1775..1768])),CHR$(INT(SHARED_BUFFER[1783..1776]))
        ,CHR$(INT(SHARED_BUFFER[1791..1784])),CHR$(INT(SHARED_BUFFER[1799..1792]))
        ,CHR$(INT(SHARED_BUFFER[1807..1800])),CHR$(INT(SHARED_BUFFER[1815..1808]))
        ,CHR$(INT(SHARED_BUFFER[1823..1816]));
    IF ( ! (SHARED_BUFFER[4472]==1) ) THEN GOTO NOTM3PART;
    PRINT "Cortex-M3 Enabled (M3_ALLOWED = 1)";
    NOTM3PART:
    IF ( ! (SHARED_BUFFER[4472]==0) ) THEN GOTO M3PART;
    PRINT "Cortex-M3 Disabled (M3_ALLOWED = 0)";
    M3PART:
    BUFF32[15..0] = $ffff;
    IF ( ! (INT(SHARED_BUFFER[4327..4312])!=INT(BUFF32[15..0])) ) THEN GOTO DONT_DISPLAY_GRADE;
    EXPORT "Grade", SHARED_BUFFER[4343..4216];
    DONT_DISPLAY_GRADE:
    LABEL_SEPARATOR = 0;
    DONTDISPLAY:
    IF ( ! (ACTIONTYPE==ACTION_READ_DEV_CERT) ) THEN GOTO DONT_DUMP_ENTIRE_CERT;
    BOOLEAN DEV_CERT_REV_BYTEORDER[6144];
    FOR I = 0 TO 6135 STEP 8;
        DEV_CERT_REV_BYTEORDER[(I+7)..I] = SHARED_BUFFER[(6143-I)..(6136-I)];
    NEXT I;
    EXPORT "DEVICE_CERTIFICATE(LSB->MSB)", DEV_CERT_REV_BYTEORDER[6143..0];
    DONT_DUMP_ENTIRE_CERT:
    LABEL_SEPARATOR = 0;
    READ_CERT_INVALID:
    IF ( ! ( (ACTIONTYPE==ACTION_READ_DEV_CERT)&&(READ_CERT_RESULT[0]==0)) ) THEN GOTO NOT_READ_DEV_CERT;
    STATUS = -38;
    IF ( ! (READ_CERT_RESULT[1]==0) ) THEN GOTO READ_CERT_VALID1;
    PRINT "Device certificate is invalid.";
    UNIQUEEXITCODE = 32850;
    READ_CERT_VALID1:
    IF ( ! (READ_CERT_RESULT[1]==1) ) THEN GOTO READ_CERT_VALID2;
    PRINT "Failed to read device certificate (AHB HRESP error).";
    UNIQUEEXITCODE = 32852;
    READ_CERT_VALID2:
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    NOT_READ_DEV_CERT:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_SET_COFC_SIZE USES GV;
    COFC_FORMAT = 1;
    IF ( ! (INT(ID[27..0])==INT(M2S050[31..0])) ) THEN GOTO NOT_050;
    IF ( ! (IDREV<4) ) THEN GOTO NEW_050;
    COFC_FORMAT = 0;
    NEW_050:
    LABEL_SEPARATOR = 0;
    NOT_050:
    IF ( ! ( ( ( ( (INT(ID[27..0])==INT(M2S010[31..0]))||(INT(ID[27..0])==INT(M2S025[31..0])))||(INT(ID[27..0])==INT(M2S005[31..0])))||(INT(ID[27..0])==INT(M2S150[31..0])))||(INT(ID[27..0])==INT(M2S090[31..0]))) ) THEN GOTO NOT_OLD_COFC_DEVICE;
    IF ( ! (IDREV<1) ) THEN GOTO NEW_REV;
    COFC_FORMAT = 0;
    NEW_REV:
    LABEL_SEPARATOR = 0;
    NOT_OLD_COFC_DEVICE:
    IF ( ! (COFC_FORMAT==1) ) THEN GOTO OLD_COFC1;
    CERTIFICATE_SIZE = 912;
    OLD_COFC1:
    IF ( ! (COFC_FORMAT==0) ) THEN GOTO NEW_COFC;
    CERTIFICATE_SIZE = 656;
    NEW_COFC:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PROC_ENABLE USES GV,DO_EXIT,SET_PGM_MODE,DO_READ_SECURITY,DO_SET_COFC_SIZE;
    CALL DO_SET_COFC_SIZE;
    CALL SET_PGM_MODE;
    CALL DO_READ_SECURITY;
    BOOLEAN ISC_ENABLE_RESULT[32];
    BPGMMODE = 1;
    PASS = 0;
    BSR[665..0] = BSRPATTERN[665..0];
    BOOLEAN SHIFT_DATA[666];
    IRSCAN 8, $01;
    DRSCAN 666, BSR[];
    WAIT IDLE, 1 CYCLES;
    DRSCAN 666, SHIFT_DATA[], CAPTURE SAMPLE_DEVICE[];
    FOR I = 0 TO 665;
        IF ( ! (SAMPLEMASK[I]==1) ) THEN GOTO NOT_SAMPLE_MASK;
        BSR[I] = SAMPLE_DEVICE[I];
        NOT_SAMPLE_MASK:
        LABEL_SEPARATOR = 0;
    NEXT I;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $01;
    DRSCAN 666, BSR[];
    WAIT IDLE, 1 CYCLES;
    BOOLEAN TOOLINFO[32];
    TOOLINFO[5..0] = ACT_UROW_ALGO_VERSION[5..0];
    TOOLINFO[9..6] = ACT_UROW_PROGRAM_SW[3..0];
    TOOLINFO[22..17] = ACT_UROW_SW_VERSION[5..0];
    TOOLINFO[25..23] = ACT_UROW_PGM_SW[2..0];
    TOOLINFO[28..26] = BOOL(3);
    TOOLINFO[31..29] = BOOL(2);
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==0) ) THEN GOTO NOT_BLANK_PRE;
    PASS = 0;
    BOOLEAN DPC_RESULT[64];
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $da;
    DRSCAN 64, $0000000004024040;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 64, $0000000000000000, CAPTURE DPC_RESULT[];
        IF ( ! (DPC_RESULT[63]==0) ) THEN GOTO DPC1_POLL;
        IPOLL = 0;
        PASS = 1;
        DPC1_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DPC1_DONE;
        IRSCAN 8, $da;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DPC1_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    NOT_BLANK_PRE:
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $80;
    DRSCAN 32, TOOLINFO[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE ISC_ENABLE_RESULT[31..0];
        IF ( ! (INT(ISC_ENABLE_RESULT[23..0])==INT(TOOLINFO[23..0])) ) THEN GOTO JTAG_NOT_LOCKED;
        PRINT "JTAG interface is protected by UPK1";
        STATUS = -30;
        UNIQUEEXITCODE = 32815;
        BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
        EXPORT "ERROR_CODE", BUFF32[15..0];
        CALL DO_EXIT;
        JTAG_NOT_LOCKED:
        IF ( ! (ISC_ENABLE_RESULT[31]==0) ) THEN GOTO ISC_ENABLE_POLL;
        IPOLL = 0;
        PASS = 1;
        ISC_ENABLE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO ISC_ENABLE_DONE;
        IRSCAN 8, $80;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        ISC_ENABLE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    EXPORT "ISC_ENABLE_RESULT", ISC_ENABLE_RESULT[];
    EXPORT "CRCERR", ISC_ENABLE_RESULT[0..0];
    EXPORT "EDCERR", ISC_ENABLE_RESULT[1..1];
    IF ( ! (PASS==0) ) THEN GOTO ISC_ENABLE_NOT_TIMED_OUT;
    PRINT "Instruction timed out while entering programming mode.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    ISC_ENABLE_NOT_TIMED_OUT:
    IF ( ! ( ( (PASS==1)&&(ISC_ENABLE_RESULT[0]==1))||( (PASS==1)&&(INT(ISC_ENABLE_RESULT[31..0])==0))) ) THEN GOTO ISC_ENABLE_PASS;
    PRINT "Failed to enter programming mode.";
    STATUS = 5;
    UNIQUEEXITCODE = 32771;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    ISC_ENABLE_PASS:
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==0) ) THEN GOTO NOT_BLANK_POST;
    PASS = 0;
    DPC_RESULT[63..0] = $0000000000000000;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $da;
    DRSCAN 64, $0000000004024840;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 64, $0000000000000000, CAPTURE DPC_RESULT[];
        IF ( ! (DPC_RESULT[63]==0) ) THEN GOTO DPC2_POLL;
        IPOLL = 0;
        PASS = 1;
        DPC2_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DPC2_DONE;
        IRSCAN 8, $da;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DPC2_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    NOT_BLANK_POST:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PRINT_IDCODE USES GV;
    EXPORT "IDCODE", ID[];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE VERIFY_IDCODE USES GV,PARAMETERS,DO_EXIT,POLL_DEVICE_READY;
    FREQUENCY (FREQ*1000000);
    WAIT RESET, 5 CYCLES;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $0f;
    DRSCAN 32, $00000000;
    WAIT IDLE, 1 CYCLES;
    DRSCAN 32, $00000000, CAPTURE ID[],COMPARE IDCODEVALUE[],IDMASK[],PASS;
    IF ( ! (PASS==0) ) THEN GOTO IDOK;
    STATUS = 6;
    UNIQUEEXITCODE = 32772;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    PRINT "Failed to verify IDCODE";
    CALL DO_EXIT;
    IDOK:
    IDREV = INT(ID[31..28]);
    CALL POLL_DEVICE_READY;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE GET_DATA_STATUS USES GV,DO_EXIT;
    INTEGER IPOLLDATA =0;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $c9;
    DRSCAN 32, $00000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLLDATA = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE DATA_STATUS_RESULT[31..0];
        IF ( ! (DATA_STATUS_RESULT[31]==0) ) THEN GOTO DATA_STATUS_POLL;
        IPOLLDATA = 0;
        PASS = 1;
        DATA_STATUS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DATA_STATUS_READ;
        IRSCAN 8, $c9;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DATA_STATUS_READ:
        LABEL_SEPARATOR = 0;
    NEXT IPOLLDATA;
    IF ( ! (PASS==0) ) THEN GOTO GET_DATA_NOT_TIMED_OUT;
    PRINT "Instruction timed out while reading datablock status.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    GET_DATA_NOT_TIMED_OUT:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_CERTIFICATE USES GV,READ_SHARED_BUFFER;
    IBLOCKS = (CERTIFICATE_SIZE/128);
    IF ( ! ((CERTIFICATE_SIZE%128)!=0) ) THEN GOTO NO_INCOM_BLOCK;
    IBLOCKS = (IBLOCKS+1);
    NO_INCOM_BLOCK:
    CALL READ_SHARED_BUFFER;
    COMPONENTDIGEST[255..0] = SHARED_BUFFER[399..144];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE PROCESS_DATA USES BITSTREAM,GV,CONSTBLOCK,DO_EXIT,GET_DATA_STATUS,READ_CERTIFICATE;
    BOOLEAN DATA_SHIFT_RESULT[128];
    INTEGER BLOCKNO =0;
    INTEGER CURRNUMOFBLOCKS =0;
    INTEGER COMPONENTNO =0;
    INTEGER TOTALNUMOFBLOCKS =0;
    INTEGER TOTALCURRBLOCK =0;
    IF ( ! (ICURNUMOFCOMPONENTS>ICURCOMPONENTNO) ) THEN GOTO DONT_UPDATE_BAR;
    FOR COMPONENTNO = (ICURCOMPONENTNO+1) TO ICURNUMOFCOMPONENTS STEP 1;
        CURRNUMOFBLOCKS = INT(NUMOFBLOCKS[((COMPONENTNO*22)-1)..((COMPONENTNO-1)*22)]);
        TOTALNUMOFBLOCKS = (TOTALNUMOFBLOCKS+CURRNUMOFBLOCKS);
    NEXT COMPONENTNO;
    DONT_UPDATE_BAR:
    FOR COMPONENTNO = ICURCOMPONENTNO TO ICURNUMOFCOMPONENTS STEP 1;
        IRSCAN 8, $ee;
        DRSCAN 128, DATASTREAM[(DATAINDEX+127)..DATAINDEX];
        COMPONENETSUPPORTSCERT = 0;
        COMPTYPE = COMP_UNDEF;
        CURRNUMOFBLOCKS = INT(NUMOFBLOCKS[((COMPONENTNO*22)-1)..((COMPONENTNO-1)*22)]);
        FOR BLOCKNO = 1 TO CURRNUMOFBLOCKS STEP 1;
            IF ( ! (COMPONENTNO!=ICURCOMPONENTNO) ) THEN GOTO FIRST_COMP;
            TOTALCURRBLOCK = (TOTALCURRBLOCK+1);
            FIRST_COMP:
            IF ( ! (BLOCKNO==4) ) THEN GOTO NOT_FOURTH_BLOCK;
            COMPTYPE = INT(DATASTREAM[(DATAINDEX+7)..DATAINDEX]);
            NOT_FOURTH_BLOCK:
            IF ( ! (BLOCKNO==1) ) THEN GOTO NOT_FIRST_BLOCK1;
            COMPONENETSUPPORTSCERT = INT(DATASTREAM[(DATAINDEX+2721)..(DATAINDEX+2721)]);
            NOT_FIRST_BLOCK1:
            PASS = 0;
            WAIT 45 USEC, DRPAUSE;
            FOR IPOLL = 510000 TO 0 STEP -1;
                IF ( ! (IPOLL==510000) ) THEN GOTO NOT_FIRST_POLL;
                IF ( ! (COMPTYPE==COMP_BITS) ) THEN GOTO NOT_COMP_0;
                IF ( ! (SEC_UCNFG[12]==1) ) THEN GOTO RECOVERY_ENABLED;
                IPOLL = 250000;
                RECOVERY_ENABLED:
                LABEL_SEPARATOR = 0;
                NOT_COMP_0:
                IF ( ! (COMPTYPE!=0) ) THEN GOTO COMP_0;
                IPOLL = 83333;
                COMP_0:
                LABEL_SEPARATOR = 0;
                NOT_FIRST_POLL:
                IF ( ! ( (COMPONENTNO!=ICURNUMOFCOMPONENTS)||(BLOCKNO!=CURRNUMOFBLOCKS)) ) THEN GOTO LAST_BLOCK;
                DRSCAN 128, DATASTREAM[(DATAINDEX+255)..(DATAINDEX+128)], CAPTURE DATA_SHIFT_RESULT[127..0];
                LAST_BLOCK:
                IF ( ! ( (COMPONENTNO==ICURNUMOFCOMPONENTS)&&(BLOCKNO==CURRNUMOFBLOCKS)) ) THEN GOTO NOT_LAST_BLOCK;
                DRSCAN 128, DATASTREAM[(DATAINDEX+127)..DATAINDEX], CAPTURE DATA_SHIFT_RESULT[127..0];
                NOT_LAST_BLOCK:
                IF ( ! (DATA_SHIFT_RESULT[127]==0) ) THEN GOTO DATA_POLL;
                IPOLL = 0;
                PASS = 1;
                DATA_POLL:
                IF ( ! (PASS==0) ) THEN GOTO DATA_DONE;
                IRSCAN 8, $ee;
                WAIT IRPAUSE, 10 USEC, IRPAUSE;
                DATA_DONE:
                LABEL_SEPARATOR = 0;
            NEXT IPOLL;
            IF ( ! ( (PASS==0)||( (PASS==1)&&( (DATA_SHIFT_RESULT[3]==1)||(DATA_SHIFT_RESULT[4]==1)))) ) THEN GOTO DATA_PASS;
            IF ( ! (PASS==0) ) THEN GOTO POLL_COMPLETED;
            PRINT "Instruction timed out.";
            PRINT "componentNo: ",COMPONENTNO;
            PRINT "blockNo: ",BLOCKNO;
            STATUS = -32;
            UNIQUEEXITCODE = 32818;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            CALL DO_EXIT;
            POLL_COMPLETED:
            CALL GET_DATA_STATUS;
            IF ( ! ( (PASS==1)&&(DATA_STATUS_RESULT[2]==1)) ) THEN GOTO NO_ERROR_PER_BLOCK;
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])!=0) ) THEN GOTO NOT_AUTHERR;
            PRINT "Authentication Error.";
            IF ( ! ( ( ( (INT(DATA_STATUS_RESULT[15..8])==1)||(INT(DATA_STATUS_RESULT[15..8])==2))||(INT(DATA_STATUS_RESULT[15..8])==4))||(INT(DATA_STATUS_RESULT[15..8])==8)) ) THEN GOTO NOT_INVALID_BITSTREAM;
            PRINT "Bitstream or data is corrupted or noisy.";
            STATUS = -22;
            UNIQUEEXITCODE = 32799;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_INVALID_BITSTREAM:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==3) ) THEN GOTO ENC_KEY_SATISFIED;
            PRINT "Invalid/Corrupted encryption key.";
            STATUS = -23;
            UNIQUEEXITCODE = 32801;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            ENC_KEY_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==5) ) THEN GOTO BACKLEVEL_SATISFIED;
            PRINT "Back level not satisfied.";
            STATUS = -24;
            UNIQUEEXITCODE = 32803;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BACKLEVEL_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==7) ) THEN GOTO DSN_SATISFIED;
            PRINT "DSN binding mismatch";
            STATUS = -25;
            UNIQUEEXITCODE = 32805;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DSN_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==9) ) THEN GOTO DEVCAP_SATISFIED;
            PRINT "Bitstream and device mismatch";
            STATUS = -26;
            UNIQUEEXITCODE = 32807;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVCAP_SATISFIED:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==10) ) THEN GOTO CORRECT_IDCODE;
            PRINT "Incorrect DEVICEID.";
            STATUS = -27;
            UNIQUEEXITCODE = 32809;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            CORRECT_IDCODE:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==11) ) THEN GOTO BITSTREAM_FINE;
            PRINT "Signal integrity issues on JTAG pins, please check.";
            STATUS = -28;
            UNIQUEEXITCODE = 32811;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BITSTREAM_FINE:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==12) ) THEN GOTO BITSTREAM_VER;
            PRINT "Programming file does not support verification.";
            STATUS = -29;
            UNIQUEEXITCODE = 32813;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            BITSTREAM_VER:
            IF ( ! (INT(DATA_STATUS_RESULT[15..8])==13) ) THEN GOTO DEVCAP_ACCESS;
            PRINT "Invalid or inaccessible Device Certificate.";
            STATUS = -31;
            UNIQUEEXITCODE = 32816;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVCAP_ACCESS:
            LABEL_SEPARATOR = 0;
            NOT_AUTHERR:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])!=0) ) THEN GOTO NOT_ERRORCODE;
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==5) ) THEN GOTO NOT_NVMVERIFY;
            IF ( ! (PREPARING_BITSTREAM==0) ) THEN GOTO SKIP_VERIFYNVM_DISP;
            PRINT "Failed to verify eNVM.";
            STATUS = 11;
            UNIQUEEXITCODE = 32776;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            SKIP_VERIFYNVM_DISP:
            LABEL_SEPARATOR = 0;
            NOT_NVMVERIFY:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==4) ) THEN GOTO NOT_NVMPRG;
            PRINT "Failed to program eNVM.";
            STATUS = 10;
            UNIQUEEXITCODE = 32773;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            NOT_NVMPRG:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==2) ) THEN GOTO DEVICE_NO_SEC;
            PRINT "Device security prevented operation.";
            STATUS = -21;
            UNIQUEEXITCODE = 32797;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            DEVICE_NO_SEC:
            IF ( ! (INT(DATA_STATUS_RESULT[7..3])==1) ) THEN GOTO FABRIC_VER_FINE;
            IF ( ! (PREPARING_BITSTREAM==0) ) THEN GOTO SKIP_VERIFY_DISP;
            IF ( ! (INT(DATA_STATUS_RESULT[23..16])==248) ) THEN GOTO NOT_FC;
            PRINT "Failed to verify Fabric Configuration.";
            NOT_FC:
            IF ( ! ( ( (INT(DATA_STATUS_RESULT[23..16])==249)||(INT(DATA_STATUS_RESULT[23..16])==250))||(INT(DATA_STATUS_RESULT[23..16])==251)) ) THEN GOTO NOT_SEC;
            PRINT "Failed to verify Security.";
            NOT_SEC:
            IF ( ! ( ( ( (INT(DATA_STATUS_RESULT[23..16])!=248)&&(INT(DATA_STATUS_RESULT[23..16])!=249))&&(INT(DATA_STATUS_RESULT[23..16])!=250))&&(INT(DATA_STATUS_RESULT[23..16])!=251)) ) THEN GOTO NOT_FABRIC;
            PRINT "Failed to verify FPGA Array.";
            NOT_FABRIC:
            STATUS = 11;
            UNIQUEEXITCODE = 32775;
            BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
            EXPORT "ERROR_CODE", BUFF32[15..0];
            SKIP_VERIFY_DISP:
            LABEL_SEPARATOR = 0;
            FABRIC_VER_FINE:
            LABEL_SEPARATOR = 0;
            NOT_ERRORCODE:
            IF ( ! ( (PREPARING_BITSTREAM==0)||(INT(DATA_STATUS_RESULT[15..8])!=0)) ) THEN GOTO SKIP_VERIFY_EXIT;
            IF ( ! (COMPTYPE==COMP_BITS) ) THEN GOTO NOT_BITS_COMP;
            PRINT "Component: BITS";
            NOT_BITS_COMP:
            IF ( ! (COMPTYPE==COMP_FPGA) ) THEN GOTO NOT_FPGA_COMP;
            PRINT "Component: FPGA";
            NOT_FPGA_COMP:
            IF ( ! (COMPTYPE==COMP_KEYS) ) THEN GOTO NOT_SEC_COMP;
            PRINT "Component: Security";
            NOT_SEC_COMP:
            IF ( ! (COMPTYPE==COMP_ENVM) ) THEN GOTO NOT_ENVM_COMP;
            PRINT "Component: eNVM";
            NOT_ENVM_COMP:
            IF ( ! (COMPTYPE==COMP_EOB) ) THEN GOTO NOT_EOB_COMP;
            PRINT "Component: EOB";
            NOT_EOB_COMP:
            PRINT "componentNo: ",COMPONENTNO;
            PRINT "blockNo: ",BLOCKNO;
            EXPORT "DATA_STATUS_RESULT: ", DATA_STATUS_RESULT[31..0];
            CALL DO_EXIT;
            SKIP_VERIFY_EXIT:
            LABEL_SEPARATOR = 0;
            NO_ERROR_PER_BLOCK:
            LABEL_SEPARATOR = 0;
            DATA_PASS:
            IF ( ! ( (COMPONENTNO!=ICURCOMPONENTNO)&&((TOTALCURRBLOCK%1500)==0)) ) THEN GOTO DONT_UPDATE_PERCENTAGE;
            PERCENT_UPDATE = ((100*TOTALCURRBLOCK)/TOTALNUMOFBLOCKS);
            EXPORT "PERCENT_DONE", PERCENT_UPDATE;
            DONT_UPDATE_PERCENTAGE:
            DATAINDEX = (DATAINDEX+128);
        NEXT BLOCKNO;
        IF ( ! ( (ACTIONTYPE==ACTION_PROG)&&(COMPONENETSUPPORTSCERT==1)) ) THEN GOTO DONT_DUMP_DIGEST1;
        IF ( ! (COMPTYPE==COMP_FPGA) ) THEN GOTO DUMMY2;
        CALL READ_CERTIFICATE;
        EXPORT "Fabric component digest", COMPONENTDIGEST[];
        DUMMY2:
        IF ( ! (COMPTYPE==COMP_ENVM) ) THEN GOTO DUMMY4;
        CALL READ_CERTIFICATE;
        EXPORT "eNVM component digest", COMPONENTDIGEST[];
        DUMMY4:
        LABEL_SEPARATOR = 0;
        DONT_DUMP_DIGEST1:
        LABEL_SEPARATOR = 0;
    NEXT COMPONENTNO;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_MODE USES GV,DO_EXIT,LOAD_AUXLO;
    IF ( ! (COFC_FORMAT==1) ) THEN GOTO OLD_COFC2;
    AUXLO_REG[127..0] = COFC_NONCE[127..0];
    CALL LOAD_AUXLO;
    OLD_COFC2:
    BOOLEAN DATA_INIT_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $ae;
    DRSCAN 8, PGMMODE[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE DATA_INIT_RESULT[7..0];
        IF ( ! (DATA_INIT_RESULT[7]==0) ) THEN GOTO DATA_INIT_POLL;
        IPOLL = 0;
        PASS = 1;
        DATA_INIT_POLL:
        IF ( ! (PASS==0) ) THEN GOTO DATA_INIT_DONE;
        IRSCAN 8, $ae;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        DATA_INIT_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO DATA_INIT_PASSED;
    PRINT "Instruction timed out while setting programming mode.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    DATA_INIT_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_ERASE USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Erasing FPGA Array...";
    PGMMODE[7..0] = $01;
    CALL SET_MODE;
    DATAINDEX = DATAERASESTARTINDEX;
    ICURCOMPONENTNO = ((DATASIZE+DATAENVMSIZE)+1);
    ICURNUMOFCOMPONENTS = ((DATASIZE+DATAENVMSIZE)+DATAERASESIZE);
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_PREPARE_BITSTREAM USES GV,CONSTBLOCK,PROCESS_DATA,SET_MODE;
    PREPARING_BITSTREAM = 1;
    PGMMODE[7..0] = $02;
    CALL SET_MODE;
    ORIGACTIONTYPE = ACTIONTYPE;
    ACTIONTYPE = ACTION_VER;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = 2;
    DATAINDEX = DATASTARTINDEX;
    PREV_NUM_OF_BLOCKS = INT(NUMOFBLOCKS[43..22]);
    BUFF32[31..0] = BOOL(91);
    NUMOFBLOCKS[43..22] = BUFF32[21..0];
    CALL PROCESS_DATA;
    NUMOFBLOCKS[43..22] = BOOL(PREV_NUM_OF_BLOCKS);
    PREPARING_BITSTREAM = 0;
    ACTIONTYPE = ORIGACTIONTYPE;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY USES GV,PROCESS_DATA,SET_MODE;
    IF ( ! (RANPROGRAMMINGACTION==1) ) THEN GOTO RAN_PROGRAM;
    RANPROGRAMMINGACTION = 0;
    RAN_PROGRAM:
    PRINT "Verifying FPGA Array...";
    PGMMODE[7..0] = $02;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_PROGRAM USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Programming FPGA Array...";
    PGMMODE[7..0] = $01;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    RANPROGRAMMINGACTION = 1;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_AUTHENTICATION USES GV,PROCESS_DATA,SET_MODE;
    PRINT "Encrypted data authentication...";
    PGMMODE[7..0] = $00;
    CALL SET_MODE;
    ICURCOMPONENTNO = 1;
    ICURNUMOFCOMPONENTS = DATASIZE;
    DATAINDEX = DATASTARTINDEX;
    CALL PROCESS_DATA;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DUMP_PROGRAMMING_INTERFACE USES GV,CONSTBLOCK;
    INTEGER PROGRAMMODE =0;
    BUFF32[31..0] = READ_PROG_INFO_RESULT[95..64];
    PROGRAMMODE = INT(BUFF32[28..26]);
    IF ( ! (PROGRAMMODE==SPI_MASTER) ) THEN GOTO NOT_SPI_MASTER;
    PRINT "Programming Interface Protocol: SPI Master";
    NOT_SPI_MASTER:
    IF ( ! (PROGRAMMODE==SPI_SLAVE) ) THEN GOTO NOT_SPI_SLAVE;
    PRINT "Programming Interface Protocol: SPI Slave";
    NOT_SPI_SLAVE:
    IF ( ! (PROGRAMMODE==JTAG) ) THEN GOTO NOT_JTAG;
    PRINT "Programming Interface Protocol: JTAG";
    NOT_JTAG:
    IF ( ! ( (PROGRAMMODE==0)||(PROGRAMMODE>3)) ) THEN GOTO Label_0;
    PRINT "Programming Interface Protocol:";
    Label_0:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DUMP_PROG_INFO USES GV,CONSTBLOCK,DUMP_PROGRAMMING_INTERFACE;
    INTEGER TMPINT =0;
    BUFF32[31..0] = READ_PROG_INFO_RESULT[95..64];
    IF ( ! (INT(READ_PROG_INFO_RESULT[15..0])!=65535) ) THEN GOTO UNKNOWN_CYCLE_COUNT;
    PRINT "CYCLE COUNT: ",INT(READ_PROG_INFO_RESULT[15..0]);
    UNKNOWN_CYCLE_COUNT:
    IF ( ! (INT(READ_PROG_INFO_RESULT[15..0])==65535) ) THEN GOTO KNOWN_CYCLE_COUNT;
    PRINT "CYCLE COUNT: Not available";
    KNOWN_CYCLE_COUNT:
    EXPORT "PROG_INFO", READ_PROG_INFO_RESULT[127..0];
    TMPINT = INT(READ_PROG_INFO_RESULT[48..48]);
    IF ( ! (TMPINT==0) ) THEN GOTO NOT_12;
    PRINT "VCC was programmed at 1.2V";
    NOT_12:
    IF ( ! (TMPINT==1) ) THEN GOTO NOT_10;
    PRINT "VCC was programmed at 1.0V";
    NOT_10:
    PRINT "Warning: Algorithm Version, Programmer, Software Version, Programming Software
        , Programming Interface Protocol, and Programming File Type information do not get programmed with Auto Programming
        , Auto Update (IAP), Programming Recovery, or IAP/ISP Services and should be ignored.";
    TMPINT = INT(BUFF32[5..0]);
    IF ( ! ( (TMPINT==0)||(TMPINT==63)) ) THEN GOTO NOT_UNDEF;
    PRINT "Algorithm Version:";
    NOT_UNDEF:
    IF ( ! ( (TMPINT!=0)&&(TMPINT!=63)) ) THEN GOTO UNDEF;
    PRINT "Algorithm Version: ",INT(BUFF32[5..0]);
    UNDEF:
    TMPINT = INT(BUFF32[9..6]);
    IF ( ! (TMPINT==SELF) ) THEN GOTO NOT_SELF;
    PRINT "Programmer: SPI Master Auto Programming";
    NOT_SELF:
    IF ( ! (TMPINT==SCULPTW) ) THEN GOTO NOT_SCULPTW;
