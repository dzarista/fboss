PROCEDURE SHA256_INIT USES GV,SHA256;
    INTEGER SHA256_INIT_I;
    SHA256_CTX_DATALEN = 0;
    SHA256_CTX_BITLEN = 0;
    SHA256_CTX_STATE[0] = INT($6a09e667);
    SHA256_CTX_STATE[1] = INT($bb67ae85);
    SHA256_CTX_STATE[2] = INT($3c6ef372);
    SHA256_CTX_STATE[3] = INT($a54ff53a);
    SHA256_CTX_STATE[4] = INT($510e527f);
    SHA256_CTX_STATE[5] = INT($9b05688c);
    SHA256_CTX_STATE[6] = INT($1f83d9ab);
    SHA256_CTX_STATE[7] = INT($5be0cd19);
    FOR SHA256_INIT_I = 0 TO 63 STEP 1;
        SHA256_CTX_DATA[SHA256_INIT_I] = 0;
    NEXT SHA256_INIT_I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_RSHIFT USES GV,SHA256;
    BOOLEAN SHA256_RSHIFT_SRC[32];
    BOOLEAN SHA256_RSHIFT_DST[32] = $00000000;
    SHA256_RSHIFT_SRC[31..0] = BOOL(SHA256_RSHIFT_X);
    SHA256_RSHIFT_DST[(31-SHA256_RSHIFT_Y)..0] = SHA256_RSHIFT_SRC[31..SHA256_RSHIFT_Y];
    SHA256_RSHIFT_RES = INT(SHA256_RSHIFT_DST[]);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_ROTRIGHT USES GV,SHA256,SHA256_RSHIFT;
    SHA256_RSHIFT_X = SHA256_ROTRIGHT_A;
    SHA256_RSHIFT_Y = SHA256_ROTRIGHT_B;
    CALL SHA256_RSHIFT;
    SHA256_ROTRIGHT_RES = (SHA256_RSHIFT_RES|(SHA256_ROTRIGHT_A<<(32-SHA256_ROTRIGHT_B)));
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_EP0 USES GV,SHA256,SHA256_ROTRIGHT;
    INTEGER SHA256_EP0_A;
    INTEGER SHA256_EP0_B;
    INTEGER SHA256_EP0_C;
    SHA256_ROTRIGHT_A = SHA256_EP0_X;
    SHA256_ROTRIGHT_B = 2;
    CALL SHA256_ROTRIGHT;
    SHA256_EP0_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 13;
    CALL SHA256_ROTRIGHT;
    SHA256_EP0_B = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 22;
    CALL SHA256_ROTRIGHT;
    SHA256_EP0_C = SHA256_ROTRIGHT_RES;
    SHA256_EP0_RES = ((SHA256_EP0_A^SHA256_EP0_B)^SHA256_EP0_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_EP1 USES GV,SHA256,SHA256_ROTRIGHT;
    INTEGER SHA256_EP1_A;
    INTEGER SHA256_EP1_B;
    INTEGER SHA256_EP1_C;
    SHA256_ROTRIGHT_A = SHA256_EP1_X;
    SHA256_ROTRIGHT_B = 6;
    CALL SHA256_ROTRIGHT;
    SHA256_EP1_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 11;
    CALL SHA256_ROTRIGHT;
    SHA256_EP1_B = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 25;
    CALL SHA256_ROTRIGHT;
    SHA256_EP1_C = SHA256_ROTRIGHT_RES;
    SHA256_EP1_RES = ((SHA256_EP1_A^SHA256_EP1_B)^SHA256_EP1_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_CH USES GV,SHA256;
    SHA256_CH_RES = ((SHA256_CH_X&SHA256_CH_Y)^((~SHA256_CH_X)&SHA256_CH_Z));
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_SIG0 USES GV,SHA256,SHA256_RSHIFT,SHA256_ROTRIGHT;
    INTEGER SHA256_SIG0_A;
    INTEGER SHA256_SIG0_B;
    INTEGER SHA256_SIG0_C;
    SHA256_ROTRIGHT_A = SHA256_SIG0_X;
    SHA256_ROTRIGHT_B = 7;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG0_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 18;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG0_B = SHA256_ROTRIGHT_RES;
    SHA256_RSHIFT_X = SHA256_SIG0_X;
    SHA256_RSHIFT_Y = 3;
    CALL SHA256_RSHIFT;
    SHA256_SIG0_C = SHA256_RSHIFT_RES;
    SHA256_SIG0_RES = ((SHA256_SIG0_A^SHA256_SIG0_B)^SHA256_SIG0_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_SIG1 USES GV,SHA256,SHA256_RSHIFT,SHA256_ROTRIGHT;
    INTEGER SHA256_SIG1_A;
    INTEGER SHA256_SIG1_B;
    INTEGER SHA256_SIG1_C;
    SHA256_ROTRIGHT_A = SHA256_SIG1_X;
    SHA256_ROTRIGHT_B = 17;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG1_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 19;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG1_B = SHA256_ROTRIGHT_RES;
    SHA256_RSHIFT_X = SHA256_SIG1_X;
    SHA256_RSHIFT_Y = 10;
    CALL SHA256_RSHIFT;
    SHA256_SIG1_C = SHA256_RSHIFT_RES;
    SHA256_SIG1_RES = ((SHA256_SIG1_A^SHA256_SIG1_B)^SHA256_SIG1_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_MAJ USES GV,SHA256;
    SHA256_MAJ_RES = (((SHA256_MAJ_X&SHA256_MAJ_Y)^(SHA256_MAJ_X&SHA256_MAJ_Z))^(SHA256_MAJ_Y&SHA256_MAJ_Z));
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_UADD USES GV,SHA256;
    BOOLEAN SHA256_UADD_BX[32];
    BOOLEAN SHA256_UADD_BY[32];
    BOOLEAN SHA256_UADD_BRES[32] = $00000000;
    INTEGER SHA256_UADD_I;
    INTEGER SHA256_UADD_OVER =0;
    INTEGER SHA256_UADD_CNT =0;
    SHA256_UADD_BX[] = BOOL(SHA256_UADD_X);
    SHA256_UADD_BY[] = BOOL(SHA256_UADD_Y);
    FOR SHA256_UADD_I = 0 TO 31 STEP 1;
        SHA256_UADD_BRES[SHA256_UADD_I..SHA256_UADD_I] = BOOL(((INT(SHA256_UADD_BX[SHA256_UADD_I..SHA256_UADD_I])^INT(SHA256_UADD_BY[SHA256_UADD_I..SHA256_UADD_I]))^SHA256_UADD_OVER));
        SHA256_UADD_CNT = ((INT(SHA256_UADD_BX[SHA256_UADD_I..SHA256_UADD_I])+INT(SHA256_UADD_BY[SHA256_UADD_I..SHA256_UADD_I]))+SHA256_UADD_OVER);
        SHA256_UADD_OVER = 0;
        IF ( ! (SHA256_UADD_CNT>1) ) THEN GOTO SHA256_UADD1;
        SHA256_UADD_OVER = 1;
        SHA256_UADD1:
        LABEL_SEPARATOR = 0;
    NEXT SHA256_UADD_I;
    SHA256_UADD_RES = INT(SHA256_UADD_BRES[]);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_TRANSFORM USES GV,SHA256,SHA256_EP0,SHA256_EP1,SHA256_CH,SHA256_SIG0
    ,SHA256_SIG1,SHA256_MAJ,SHA256_UADD;
    INTEGER SHA256_TR_A;
    INTEGER SHA256_TR_B;
    INTEGER SHA256_TR_C;
    INTEGER SHA256_TR_D;
    INTEGER SHA256_TR_E;
    INTEGER SHA256_TR_F;
    INTEGER SHA256_TR_G;
    INTEGER SHA256_TR_H;
    INTEGER SHA256_TR_I;
    INTEGER SHA256_TR_J;
    INTEGER SHA256_TR_T1;
    INTEGER SHA256_TR_T2;
    INTEGER SHA256_TR_M[64];
    SHA256_TR_J = 0;
    FOR SHA256_TR_I = 0 TO 15 STEP 1;
        SHA256_TR_M[SHA256_TR_I] = ((((SHA256_CTX_DATA[SHA256_TR_J]<<24)|(SHA256_CTX_DATA[(SHA256_TR_J+1)]<<16))|(SHA256_CTX_DATA[(SHA256_TR_J+2)]<<8))|SHA256_CTX_DATA[(SHA256_TR_J+3)]);
        SHA256_TR_J = (SHA256_TR_J+4);
    NEXT SHA256_TR_I;
    FOR SHA256_TR_I = 16 TO 63 STEP 1;
        SHA256_SIG1_X = SHA256_TR_M[(SHA256_TR_I-2)];
        CALL SHA256_SIG1;
        SHA256_UADD_X = SHA256_SIG1_RES;
        SHA256_UADD_Y = SHA256_TR_M[(SHA256_TR_I-7)];
        CALL SHA256_UADD;
        SHA256_SIG0_X = SHA256_TR_M[(SHA256_TR_I-15)];
        CALL SHA256_SIG0;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_SIG0_RES;
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_TR_M[(SHA256_TR_I-16)];
        CALL SHA256_UADD;
        SHA256_TR_M[SHA256_TR_I] = SHA256_UADD_RES;
    NEXT SHA256_TR_I;
    SHA256_TR_A = SHA256_CTX_STATE[0];
    SHA256_TR_B = SHA256_CTX_STATE[1];
    SHA256_TR_C = SHA256_CTX_STATE[2];
    SHA256_TR_D = SHA256_CTX_STATE[3];
    SHA256_TR_E = SHA256_CTX_STATE[4];
    SHA256_TR_F = SHA256_CTX_STATE[5];
    SHA256_TR_G = SHA256_CTX_STATE[6];
    SHA256_TR_H = SHA256_CTX_STATE[7];
    FOR SHA256_TR_I = 0 TO 63 STEP 1;
        SHA256_UADD_X = SHA256_TR_H;
        SHA256_EP1_X = SHA256_TR_E;
        CALL SHA256_EP1;
        SHA256_UADD_Y = SHA256_EP1_RES;
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_CH_X = SHA256_TR_E;
        SHA256_CH_Y = SHA256_TR_F;
        SHA256_CH_Z = SHA256_TR_G;
        CALL SHA256_CH;
        SHA256_UADD_Y = SHA256_CH_RES;
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_K[(63-SHA256_TR_I)];
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_TR_M[SHA256_TR_I];
        CALL SHA256_UADD;
        SHA256_TR_T1 = SHA256_UADD_RES;
        SHA256_EP0_X = SHA256_TR_A;
        CALL SHA256_EP0;
        SHA256_UADD_X = SHA256_EP0_RES;
        SHA256_MAJ_X = SHA256_TR_A;
        SHA256_MAJ_Y = SHA256_TR_B;
        SHA256_MAJ_Z = SHA256_TR_C;
        CALL SHA256_MAJ;
        SHA256_UADD_Y = SHA256_MAJ_RES;
        CALL SHA256_UADD;
        SHA256_TR_T2 = SHA256_UADD_RES;
        SHA256_TR_H = SHA256_TR_G;
        SHA256_TR_G = SHA256_TR_F;
        SHA256_TR_F = SHA256_TR_E;
        SHA256_UADD_X = SHA256_TR_D;
        SHA256_UADD_Y = SHA256_TR_T1;
        CALL SHA256_UADD;
        SHA256_TR_E = SHA256_UADD_RES;
        SHA256_TR_D = SHA256_TR_C;
        SHA256_TR_C = SHA256_TR_B;
        SHA256_TR_B = SHA256_TR_A;
        SHA256_UADD_X = SHA256_TR_T1;
        SHA256_UADD_Y = SHA256_TR_T2;
        CALL SHA256_UADD;
        SHA256_TR_A = SHA256_UADD_RES;
    NEXT SHA256_TR_I;
    SHA256_UADD_X = SHA256_CTX_STATE[0];
    SHA256_UADD_Y = SHA256_TR_A;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[0] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[1];
    SHA256_UADD_Y = SHA256_TR_B;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[1] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[2];
    SHA256_UADD_Y = SHA256_TR_C;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[2] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[3];
    SHA256_UADD_Y = SHA256_TR_D;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[3] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[4];
    SHA256_UADD_Y = SHA256_TR_E;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[4] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[5];
    SHA256_UADD_Y = SHA256_TR_F;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[5] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[6];
    SHA256_UADD_Y = SHA256_TR_G;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[6] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[7];
    SHA256_UADD_Y = SHA256_TR_H;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[7] = SHA256_UADD_RES;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_UPDATE USES GV,SHA256,SHA256_TRANSFORM;
    INTEGER SHA256_UPDATE_I;
    FOR SHA256_UPDATE_I = 0 TO ((SHA256_UPDATE_DATA_SIZE/8)-1) STEP 1;
        SHA256_CTX_DATA[SHA256_CTX_DATALEN] = INT(SHA256_UPDATE_DATA[((SHA256_UPDATE_I*8)+7)..(SHA256_UPDATE_I*8)]);
        SHA256_CTX_DATALEN = (SHA256_CTX_DATALEN+1);
        IF ( ! (SHA256_CTX_DATALEN==64) ) THEN GOTO SHA256_UPDATE1;
        CALL SHA256_TRANSFORM;
        SHA256_CTX_BITLEN = (SHA256_CTX_BITLEN+512);
        SHA256_CTX_DATALEN = 0;
        SHA256_UPDATE1:
        LABEL_SEPARATOR = 0;
    NEXT SHA256_UPDATE_I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_FINAL USES GV,SHA256,SHA256_RSHIFT,SHA256_TRANSFORM;
    INTEGER SHA256_FINAL_I;
    SHA256_FINAL_I = SHA256_CTX_DATALEN;
    IF ( ! (SHA256_CTX_DATALEN<56) ) THEN GOTO SHA256_FINAL1;
    SHA256_CTX_DATA[SHA256_FINAL_I] = INT($80);
    SHA256_FINAL_I = (SHA256_FINAL_I+1);
    FOR SHA256_FINAL_I = SHA256_FINAL_I TO 55 STEP 1;
        SHA256_CTX_DATA[SHA256_FINAL_I] = INT($00);
    NEXT SHA256_FINAL_I;
    SHA256_FINAL1:
    IF ( ! (SHA256_CTX_DATALEN>55) ) THEN GOTO SHA256_FINAL2;
    SHA256_CTX_DATA[SHA256_FINAL_I] = INT($80);
    SHA256_FINAL_I = (SHA256_FINAL_I+1);
    FOR SHA256_FINAL_I = SHA256_FINAL_I TO 63 STEP 1;
        SHA256_CTX_DATA[SHA256_FINAL_I] = INT($00);
    NEXT SHA256_FINAL_I;
    CALL SHA256_TRANSFORM;
    FOR SHA256_FINAL_I = 0 TO 55 STEP 1;
        SHA256_CTX_DATA[SHA256_FINAL_I] = INT($00);
    NEXT SHA256_FINAL_I;
    SHA256_FINAL2:
    SHA256_CTX_BITLEN = (SHA256_CTX_BITLEN+(SHA256_CTX_DATALEN*8));
    SHA256_CTX_DATA[63] = SHA256_CTX_BITLEN;
    SHA256_RSHIFT_X = SHA256_CTX_BITLEN;
    SHA256_RSHIFT_Y = 8;
    CALL SHA256_RSHIFT;
    SHA256_CTX_DATA[62] = SHA256_RSHIFT_RES;
    SHA256_RSHIFT_Y = 16;
    CALL SHA256_RSHIFT;
    SHA256_CTX_DATA[61] = SHA256_RSHIFT_RES;
    SHA256_RSHIFT_Y = 24;
    CALL SHA256_RSHIFT;
    SHA256_CTX_DATA[60] = SHA256_RSHIFT_RES;
    SHA256_CTX_DATA[59] = 0;
    SHA256_CTX_DATA[58] = 0;
    SHA256_CTX_DATA[57] = 0;
    SHA256_CTX_DATA[56] = 0;
    CALL SHA256_TRANSFORM;
    INTEGER SHA256_FINAL_OFFSET;
    FOR SHA256_FINAL_I = 0 TO 3 STEP 1;
        SHA256_RSHIFT_Y = (24-(SHA256_FINAL_I*8));
        SHA256_RSHIFT_X = SHA256_CTX_STATE[0];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = (SHA256_FINAL_I*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[1];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+4)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[2];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+8)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[3];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+12)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[4];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+16)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[5];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+20)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[6];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+24)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[7];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+28)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
    NEXT SHA256_FINAL_I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_PROGRAM_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_PROG;
ENDPROC;

PROCEDURE SET_VERIFY_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_VER;
ENDPROC;

PROCEDURE SET_ERASE_ACTIONTYPE USES GV,CONSTBLOCK;
