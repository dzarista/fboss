    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $e9;
    DRSCAN 128, AUXLO_REG[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE AUXLO_RESULT[127..0];
