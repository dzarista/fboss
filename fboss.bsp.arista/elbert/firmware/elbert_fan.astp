    INTEGER SHA256_SIG0_RES;
    INTEGER SHA256_SIG1_X;
    INTEGER SHA256_SIG1_RES;
    INTEGER SHA256_EP0_X;
    INTEGER SHA256_EP0_RES;
    INTEGER SHA256_EP1_X;
    INTEGER SHA256_EP1_RES;
    INTEGER SHA256_CH_X;
    INTEGER SHA256_CH_Y;
    INTEGER SHA256_CH_Z;
    INTEGER SHA256_CH_RES;
    INTEGER SHA256_MAJ_X;
    INTEGER SHA256_MAJ_Y;
    INTEGER SHA256_MAJ_Z;
    INTEGER SHA256_MAJ_RES;
    INTEGER SHA256_ROTRIGHT_A;
    INTEGER SHA256_ROTRIGHT_B;
