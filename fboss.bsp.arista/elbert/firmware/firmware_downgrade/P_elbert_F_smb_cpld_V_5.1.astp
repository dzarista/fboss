    NOT_SPI_SLAVE:
    IF ( ! (TMPINT==JTAG) ) THEN GOTO NOT_JTAG;
    PRINT "Programming Interface Protocol: JTAG";
    NOT_JTAG:
    IF ( ! ( (TMPINT==0)||(TMPINT>3)) ) THEN GOTO UNDEF_P_I_P;
    PRINT "Programming Interface Protocol:";
    UNDEF_P_I_P:
