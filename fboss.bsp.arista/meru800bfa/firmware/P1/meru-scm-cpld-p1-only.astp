PROCEDURE SHA256_INIT USES GV,SHA256;
    INTEGER SHA256_INIT_I;
    SHA256_CTX_DATALEN = 0;
    SHA256_CTX_BITLEN = 0;
    SHA256_CTX_STATE[0] = INT($6a09e667);
    SHA256_CTX_STATE[1] = INT($bb67ae85);
    SHA256_CTX_STATE[2] = INT($3c6ef372);
    SHA256_CTX_STATE[3] = INT($a54ff53a);
    SHA256_CTX_STATE[4] = INT($510e527f);
    SHA256_CTX_STATE[5] = INT($9b05688c);
    SHA256_CTX_STATE[6] = INT($1f83d9ab);
    SHA256_CTX_STATE[7] = INT($5be0cd19);
    FOR SHA256_INIT_I = 0 TO 63 STEP 1;
        SHA256_CTX_DATA[SHA256_INIT_I] = 0;
    NEXT SHA256_INIT_I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_RSHIFT USES GV,SHA256;
    BOOLEAN SHA256_RSHIFT_SRC[32];
    BOOLEAN SHA256_RSHIFT_DST[32] = $00000000;
    SHA256_RSHIFT_SRC[31..0] = BOOL(SHA256_RSHIFT_X);
    SHA256_RSHIFT_DST[(31-SHA256_RSHIFT_Y)..0] = SHA256_RSHIFT_SRC[31..SHA256_RSHIFT_Y];
    SHA256_RSHIFT_RES = INT(SHA256_RSHIFT_DST[]);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_ROTRIGHT USES GV,SHA256,SHA256_RSHIFT;
    SHA256_RSHIFT_X = SHA256_ROTRIGHT_A;
    SHA256_RSHIFT_Y = SHA256_ROTRIGHT_B;
    CALL SHA256_RSHIFT;
    SHA256_ROTRIGHT_RES = (SHA256_RSHIFT_RES|(SHA256_ROTRIGHT_A<<(32-SHA256_ROTRIGHT_B)));
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_EP0 USES GV,SHA256,SHA256_ROTRIGHT;
    INTEGER SHA256_EP0_A;
    INTEGER SHA256_EP0_B;
    INTEGER SHA256_EP0_C;
    SHA256_ROTRIGHT_A = SHA256_EP0_X;
    SHA256_ROTRIGHT_B = 2;
    CALL SHA256_ROTRIGHT;
    SHA256_EP0_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 13;
    CALL SHA256_ROTRIGHT;
    SHA256_EP0_B = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 22;
    CALL SHA256_ROTRIGHT;
    SHA256_EP0_C = SHA256_ROTRIGHT_RES;
    SHA256_EP0_RES = ((SHA256_EP0_A^SHA256_EP0_B)^SHA256_EP0_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_EP1 USES GV,SHA256,SHA256_ROTRIGHT;
    INTEGER SHA256_EP1_A;
    INTEGER SHA256_EP1_B;
    INTEGER SHA256_EP1_C;
    SHA256_ROTRIGHT_A = SHA256_EP1_X;
    SHA256_ROTRIGHT_B = 6;
    CALL SHA256_ROTRIGHT;
    SHA256_EP1_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 11;
    CALL SHA256_ROTRIGHT;
    SHA256_EP1_B = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 25;
    CALL SHA256_ROTRIGHT;
    SHA256_EP1_C = SHA256_ROTRIGHT_RES;
    SHA256_EP1_RES = ((SHA256_EP1_A^SHA256_EP1_B)^SHA256_EP1_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_CH USES GV,SHA256;
    SHA256_CH_RES = ((SHA256_CH_X&SHA256_CH_Y)^((~SHA256_CH_X)&SHA256_CH_Z));
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_SIG0 USES GV,SHA256,SHA256_RSHIFT,SHA256_ROTRIGHT;
    INTEGER SHA256_SIG0_A;
    INTEGER SHA256_SIG0_B;
    INTEGER SHA256_SIG0_C;
    SHA256_ROTRIGHT_A = SHA256_SIG0_X;
    SHA256_ROTRIGHT_B = 7;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG0_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 18;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG0_B = SHA256_ROTRIGHT_RES;
    SHA256_RSHIFT_X = SHA256_SIG0_X;
    SHA256_RSHIFT_Y = 3;
    CALL SHA256_RSHIFT;
    SHA256_SIG0_C = SHA256_RSHIFT_RES;
    SHA256_SIG0_RES = ((SHA256_SIG0_A^SHA256_SIG0_B)^SHA256_SIG0_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_SIG1 USES GV,SHA256,SHA256_RSHIFT,SHA256_ROTRIGHT;
    INTEGER SHA256_SIG1_A;
    INTEGER SHA256_SIG1_B;
    INTEGER SHA256_SIG1_C;
    SHA256_ROTRIGHT_A = SHA256_SIG1_X;
    SHA256_ROTRIGHT_B = 17;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG1_A = SHA256_ROTRIGHT_RES;
    SHA256_ROTRIGHT_B = 19;
    CALL SHA256_ROTRIGHT;
    SHA256_SIG1_B = SHA256_ROTRIGHT_RES;
    SHA256_RSHIFT_X = SHA256_SIG1_X;
    SHA256_RSHIFT_Y = 10;
    CALL SHA256_RSHIFT;
    SHA256_SIG1_C = SHA256_RSHIFT_RES;
    SHA256_SIG1_RES = ((SHA256_SIG1_A^SHA256_SIG1_B)^SHA256_SIG1_C);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_MAJ USES GV,SHA256;
    SHA256_MAJ_RES = (((SHA256_MAJ_X&SHA256_MAJ_Y)^(SHA256_MAJ_X&SHA256_MAJ_Z))^(SHA256_MAJ_Y&SHA256_MAJ_Z));
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_UADD USES GV,SHA256;
    BOOLEAN SHA256_UADD_BX[32];
    BOOLEAN SHA256_UADD_BY[32];
    BOOLEAN SHA256_UADD_BRES[32] = $00000000;
    INTEGER SHA256_UADD_I;
    INTEGER SHA256_UADD_OVER =0;
    INTEGER SHA256_UADD_CNT =0;
    SHA256_UADD_BX[] = BOOL(SHA256_UADD_X);
    SHA256_UADD_BY[] = BOOL(SHA256_UADD_Y);
    FOR SHA256_UADD_I = 0 TO 31 STEP 1;
        SHA256_UADD_BRES[SHA256_UADD_I..SHA256_UADD_I] = BOOL(((INT(SHA256_UADD_BX[SHA256_UADD_I..SHA256_UADD_I])^INT(SHA256_UADD_BY[SHA256_UADD_I..SHA256_UADD_I]))^SHA256_UADD_OVER));
        SHA256_UADD_CNT = ((INT(SHA256_UADD_BX[SHA256_UADD_I..SHA256_UADD_I])+INT(SHA256_UADD_BY[SHA256_UADD_I..SHA256_UADD_I]))+SHA256_UADD_OVER);
        SHA256_UADD_OVER = 0;
        IF ( ! (SHA256_UADD_CNT>1) ) THEN GOTO SHA256_UADD1;
        SHA256_UADD_OVER = 1;
        SHA256_UADD1:
        LABEL_SEPARATOR = 0;
    NEXT SHA256_UADD_I;
    SHA256_UADD_RES = INT(SHA256_UADD_BRES[]);
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_TRANSFORM USES GV,SHA256,SHA256_EP0,SHA256_EP1,SHA256_CH,SHA256_SIG0
    ,SHA256_SIG1,SHA256_MAJ,SHA256_UADD;
    INTEGER SHA256_TR_A;
    INTEGER SHA256_TR_B;
    INTEGER SHA256_TR_C;
    INTEGER SHA256_TR_D;
    INTEGER SHA256_TR_E;
    INTEGER SHA256_TR_F;
    INTEGER SHA256_TR_G;
    INTEGER SHA256_TR_H;
    INTEGER SHA256_TR_I;
    INTEGER SHA256_TR_J;
    INTEGER SHA256_TR_T1;
    INTEGER SHA256_TR_T2;
    INTEGER SHA256_TR_M[64];
    SHA256_TR_J = 0;
    FOR SHA256_TR_I = 0 TO 15 STEP 1;
        SHA256_TR_M[SHA256_TR_I] = ((((SHA256_CTX_DATA[SHA256_TR_J]<<24)|(SHA256_CTX_DATA[(SHA256_TR_J+1)]<<16))|(SHA256_CTX_DATA[(SHA256_TR_J+2)]<<8))|SHA256_CTX_DATA[(SHA256_TR_J+3)]);
        SHA256_TR_J = (SHA256_TR_J+4);
    NEXT SHA256_TR_I;
    FOR SHA256_TR_I = 16 TO 63 STEP 1;
        SHA256_SIG1_X = SHA256_TR_M[(SHA256_TR_I-2)];
        CALL SHA256_SIG1;
        SHA256_UADD_X = SHA256_SIG1_RES;
        SHA256_UADD_Y = SHA256_TR_M[(SHA256_TR_I-7)];
        CALL SHA256_UADD;
        SHA256_SIG0_X = SHA256_TR_M[(SHA256_TR_I-15)];
        CALL SHA256_SIG0;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_SIG0_RES;
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_TR_M[(SHA256_TR_I-16)];
        CALL SHA256_UADD;
        SHA256_TR_M[SHA256_TR_I] = SHA256_UADD_RES;
    NEXT SHA256_TR_I;
    SHA256_TR_A = SHA256_CTX_STATE[0];
    SHA256_TR_B = SHA256_CTX_STATE[1];
    SHA256_TR_C = SHA256_CTX_STATE[2];
    SHA256_TR_D = SHA256_CTX_STATE[3];
    SHA256_TR_E = SHA256_CTX_STATE[4];
    SHA256_TR_F = SHA256_CTX_STATE[5];
    SHA256_TR_G = SHA256_CTX_STATE[6];
    SHA256_TR_H = SHA256_CTX_STATE[7];
    FOR SHA256_TR_I = 0 TO 63 STEP 1;
        SHA256_UADD_X = SHA256_TR_H;
        SHA256_EP1_X = SHA256_TR_E;
        CALL SHA256_EP1;
        SHA256_UADD_Y = SHA256_EP1_RES;
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_CH_X = SHA256_TR_E;
        SHA256_CH_Y = SHA256_TR_F;
        SHA256_CH_Z = SHA256_TR_G;
        CALL SHA256_CH;
        SHA256_UADD_Y = SHA256_CH_RES;
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_K[(63-SHA256_TR_I)];
        CALL SHA256_UADD;
        SHA256_UADD_X = SHA256_UADD_RES;
        SHA256_UADD_Y = SHA256_TR_M[SHA256_TR_I];
        CALL SHA256_UADD;
        SHA256_TR_T1 = SHA256_UADD_RES;
        SHA256_EP0_X = SHA256_TR_A;
        CALL SHA256_EP0;
        SHA256_UADD_X = SHA256_EP0_RES;
        SHA256_MAJ_X = SHA256_TR_A;
        SHA256_MAJ_Y = SHA256_TR_B;
        SHA256_MAJ_Z = SHA256_TR_C;
        CALL SHA256_MAJ;
        SHA256_UADD_Y = SHA256_MAJ_RES;
        CALL SHA256_UADD;
        SHA256_TR_T2 = SHA256_UADD_RES;
        SHA256_TR_H = SHA256_TR_G;
        SHA256_TR_G = SHA256_TR_F;
        SHA256_TR_F = SHA256_TR_E;
        SHA256_UADD_X = SHA256_TR_D;
        SHA256_UADD_Y = SHA256_TR_T1;
        CALL SHA256_UADD;
        SHA256_TR_E = SHA256_UADD_RES;
        SHA256_TR_D = SHA256_TR_C;
        SHA256_TR_C = SHA256_TR_B;
        SHA256_TR_B = SHA256_TR_A;
        SHA256_UADD_X = SHA256_TR_T1;
        SHA256_UADD_Y = SHA256_TR_T2;
        CALL SHA256_UADD;
        SHA256_TR_A = SHA256_UADD_RES;
    NEXT SHA256_TR_I;
    SHA256_UADD_X = SHA256_CTX_STATE[0];
    SHA256_UADD_Y = SHA256_TR_A;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[0] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[1];
    SHA256_UADD_Y = SHA256_TR_B;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[1] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[2];
    SHA256_UADD_Y = SHA256_TR_C;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[2] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[3];
    SHA256_UADD_Y = SHA256_TR_D;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[3] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[4];
    SHA256_UADD_Y = SHA256_TR_E;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[4] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[5];
    SHA256_UADD_Y = SHA256_TR_F;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[5] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[6];
    SHA256_UADD_Y = SHA256_TR_G;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[6] = SHA256_UADD_RES;
    SHA256_UADD_X = SHA256_CTX_STATE[7];
    SHA256_UADD_Y = SHA256_TR_H;
    CALL SHA256_UADD;
    SHA256_CTX_STATE[7] = SHA256_UADD_RES;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_UPDATE USES GV,SHA256,SHA256_TRANSFORM;
    INTEGER SHA256_UPDATE_I;
    FOR SHA256_UPDATE_I = 0 TO ((SHA256_UPDATE_DATA_SIZE/8)-1) STEP 1;
        SHA256_CTX_DATA[SHA256_CTX_DATALEN] = INT(SHA256_UPDATE_DATA[((SHA256_UPDATE_I*8)+7)..(SHA256_UPDATE_I*8)]);
        SHA256_CTX_DATALEN = (SHA256_CTX_DATALEN+1);
        IF ( ! (SHA256_CTX_DATALEN==64) ) THEN GOTO SHA256_UPDATE1;
        CALL SHA256_TRANSFORM;
        SHA256_CTX_BITLEN = (SHA256_CTX_BITLEN+512);
        SHA256_CTX_DATALEN = 0;
        SHA256_UPDATE1:
        LABEL_SEPARATOR = 0;
    NEXT SHA256_UPDATE_I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SHA256_FINAL USES GV,SHA256,SHA256_RSHIFT,SHA256_TRANSFORM;
    INTEGER SHA256_FINAL_I;
    SHA256_FINAL_I = SHA256_CTX_DATALEN;
    IF ( ! (SHA256_CTX_DATALEN<56) ) THEN GOTO SHA256_FINAL1;
    SHA256_CTX_DATA[SHA256_FINAL_I] = INT($80);
    SHA256_FINAL_I = (SHA256_FINAL_I+1);
    FOR SHA256_FINAL_I = SHA256_FINAL_I TO 55 STEP 1;
        SHA256_CTX_DATA[SHA256_FINAL_I] = INT($00);
    NEXT SHA256_FINAL_I;
    SHA256_FINAL1:
    IF ( ! (SHA256_CTX_DATALEN>55) ) THEN GOTO SHA256_FINAL2;
    SHA256_CTX_DATA[SHA256_FINAL_I] = INT($80);
    SHA256_FINAL_I = (SHA256_FINAL_I+1);
    FOR SHA256_FINAL_I = SHA256_FINAL_I TO 63 STEP 1;
        SHA256_CTX_DATA[SHA256_FINAL_I] = INT($00);
    NEXT SHA256_FINAL_I;
    CALL SHA256_TRANSFORM;
    FOR SHA256_FINAL_I = 0 TO 55 STEP 1;
        SHA256_CTX_DATA[SHA256_FINAL_I] = INT($00);
    NEXT SHA256_FINAL_I;
    SHA256_FINAL2:
    SHA256_CTX_BITLEN = (SHA256_CTX_BITLEN+(SHA256_CTX_DATALEN*8));
    SHA256_CTX_DATA[63] = SHA256_CTX_BITLEN;
    SHA256_RSHIFT_X = SHA256_CTX_BITLEN;
    SHA256_RSHIFT_Y = 8;
    CALL SHA256_RSHIFT;
    SHA256_CTX_DATA[62] = SHA256_RSHIFT_RES;
    SHA256_RSHIFT_Y = 16;
    CALL SHA256_RSHIFT;
    SHA256_CTX_DATA[61] = SHA256_RSHIFT_RES;
    SHA256_RSHIFT_Y = 24;
    CALL SHA256_RSHIFT;
    SHA256_CTX_DATA[60] = SHA256_RSHIFT_RES;
    SHA256_CTX_DATA[59] = 0;
    SHA256_CTX_DATA[58] = 0;
    SHA256_CTX_DATA[57] = 0;
    SHA256_CTX_DATA[56] = 0;
    CALL SHA256_TRANSFORM;
    INTEGER SHA256_FINAL_OFFSET;
    FOR SHA256_FINAL_I = 0 TO 3 STEP 1;
        SHA256_RSHIFT_Y = (24-(SHA256_FINAL_I*8));
        SHA256_RSHIFT_X = SHA256_CTX_STATE[0];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = (SHA256_FINAL_I*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[1];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+4)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[2];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+8)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[3];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+12)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[4];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+16)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[5];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+20)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[6];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+24)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
        SHA256_RSHIFT_X = SHA256_CTX_STATE[7];
        CALL SHA256_RSHIFT;
        SHA256_FINAL_OFFSET = ((SHA256_FINAL_I+28)*8);
        SHA256_HASH[(SHA256_FINAL_OFFSET+7)..SHA256_FINAL_OFFSET] = BOOL(SHA256_RSHIFT_RES);
    NEXT SHA256_FINAL_I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_PROGRAM_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_PROG;
ENDPROC;

PROCEDURE SET_VERIFY_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_VER;
ENDPROC;

PROCEDURE SET_ERASE_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_ERA;
ENDPROC;

PROCEDURE SET_AUTHENTICATION_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_AUTH;
ENDPROC;

PROCEDURE SET_DEVICE_INFO_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_DEV_INFO;
ENDPROC;

PROCEDURE SET_VALIDATE_KEYS_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_VAL_KEYS;
ENDPROC;

PROCEDURE SET_READ_DEV_CERT_ACTIONTYPE USES GV,CONSTBLOCK;
    ACTIONTYPE = ACTION_READ_DEV_CERT;
ENDPROC;

PROCEDURE EXPORT_CERTIFICATES USES GV;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_FSN USES GV;
    PASS = 0;
    READ_FSN_RESULT[128..0] = $000000000000000000000000000000000;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $f0;
    DRSCAN 129, READ_FSN_RESULT[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 129, $000000000000000000000000000000000, CAPTURE READ_FSN_RESULT[];
        IF ( ! (READ_FSN_RESULT[128]==0) ) THEN GOTO READ_FSN_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_FSN_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_FSN_DONE;
        IRSCAN 8, $f0;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_FSN_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_FSN_COMPLETE;
    PRINT "Failed to read DSN.";
    STATUS = -24;
    UNIQUEEXITCODE = 32769;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    READ_FSN_COMPLETE:
    DSN[127..0] = READ_FSN_RESULT[127..0];
    IF ( ! (DUMPDSN==1) ) THEN GOTO DONT_DUMP_DSN;
    PRINT "===================================================================================";
    EXPORT "DSN", READ_FSN_RESULT[127..0];
    PRINT "===================================================================================";
    DONT_DUMP_DSN:
    DUMPDSN = 1;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_EXIT USES GV,CONSTBLOCK,EXPORT_CERTIFICATES,READ_FSN;
    IF ( ! (BPGMMODE==1) ) THEN GOTO SKIP_ISC_DISABLE;
    BOOLEAN ISC_DISABLE_RESULT[32];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $81;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE ISC_DISABLE_RESULT[31..0];
        IF ( ! (ISC_DISABLE_RESULT[31]==0) ) THEN GOTO ISC_DISABLE_POLL;
        IPOLL = 0;
        PASS = 1;
        ISC_DISABLE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO ISC_DISABLE_DONE;
        IRSCAN 8, $81;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        ISC_DISABLE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO ISC_DISABLE_PASS;
    PRINT "Instruction timed out while disabling programming mode.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    ISC_DISABLE_PASS:
    CALL READ_FSN;
    SKIP_ISC_DISABLE:
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $09;
    WAIT IDLE, 1 CYCLES;
    WAIT IDLE, 1000 USEC;
    WAIT RESET, 5 CYCLES;
    IF ( ! ( (ACTIONTYPE!=ACTION_NONE)&&(STATUS==0)) ) THEN GOTO DONT_EXPORT_COFC;
    CALL EXPORT_CERTIFICATES;
    DONT_EXPORT_COFC:
    EXIT STATUS;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_DSN_WITHOUT_DUMP USES GV,READ_FSN,DO_EXIT;
    DUMPDSN = 0;
    CALL READ_FSN;
    IF ( ! (READ_FSN_RESULT[128]==1) ) THEN GOTO DSN_NOT_BUSY2;
    CALL DO_EXIT;
    DSN_NOT_BUSY2:
    DSN[127..0] = READ_FSN_RESULT[127..0];
    DUMPDSN = 1;
ENDPROC;

PROCEDURE LOAD_AUXLO USES GV,DO_EXIT;
    BOOLEAN AUXLO_RESULT[128];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $e9;
    DRSCAN 128, AUXLO_REG[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE AUXLO_RESULT[127..0];
        IF ( ! (AUXLO_RESULT[127]==0) ) THEN GOTO AUXLO_POLL;
        IPOLL = 0;
        PASS = 1;
        AUXLO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO AUXLO_DONE;
        IRSCAN 8, $e9;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        AUXLO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO AUXLO_PASS;
    PRINT "Instruction timed out while loading auxlo.";
    EXPORT "auxlo_result", AUXLO_RESULT[127..0];
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    AUXLO_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE LOAD_AUXHI USES GV,DO_EXIT;
    BOOLEAN AUXHI_RESULT[128];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $ea;
    DRSCAN 128, AUXHI_REG[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE AUXHI_RESULT[127..0];
        IF ( ! (AUXHI_RESULT[127]==0) ) THEN GOTO AUXHI_POLL;
        IPOLL = 0;
        PASS = 1;
        AUXHI_POLL:
        IF ( ! (PASS==0) ) THEN GOTO AUXHI_DONE;
        IRSCAN 8, $ea;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        AUXHI_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO AUXHI_PASS;
    PRINT "Instruction timed out while loading auxhi.";
    EXPORT "auxhi_result", AUXHI_RESULT[127..0];
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    AUXHI_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE LOAD_KEYLO USES GV,DO_EXIT;
    BOOLEAN KEYLO_RESULT[128];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $eb;
    DRSCAN 128, KEYLO_REG[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE KEYLO_RESULT[127..0];
        IF ( ! (KEYLO_RESULT[127]==0) ) THEN GOTO KEYLO_POLL;
        IPOLL = 0;
        PASS = 1;
        KEYLO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO KEYLO_DONE;
        IRSCAN 8, $eb;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        KEYLO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO KEYLO_PASS;
    PRINT "Instruction timed out while loading keylo.";
    EXPORT "keylo_result", KEYLO_RESULT[127..0];
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    KEYLO_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE LOAD_KEYHI USES GV,DO_EXIT;
    BOOLEAN KEYHI_RESULT[128];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $ec;
    DRSCAN 128, KEYHI_REG[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE KEYHI_RESULT[127..0];
        IF ( ! (KEYHI_RESULT[127]==0) ) THEN GOTO KEYHI_POLL;
        IPOLL = 0;
        PASS = 1;
        KEYHI_POLL:
        IF ( ! (PASS==0) ) THEN GOTO KEYHI_DONE;
        IRSCAN 8, $ec;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        KEYHI_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO KEYHI_PASS;
    PRINT "Instruction timed out while loading keyhi.";
    EXPORT "keyhi_result", KEYHI_RESULT[127..0];
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    KEYHI_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DUMP_SECURITY_INFO USES GV;
    PRINT "--- Security locks and configuration settings ---";
    EXPORT "QUERY_SECURITY", SHARED_BUFFER[335..0];
    IF ( ! (SECURITY_QUERIED==1) ) THEN GOTO DO_NOT_QUERY_SEC;
    IF ( ! (SEC_UL[0]==1) ) THEN GOTO JTAGTESTDIS_SELECT;
    PRINT "JTAG test instructions are disabled.";
    JTAGTESTDIS_SELECT:
    IF ( ! (SEC_UL[1]==1) ) THEN GOTO USL_SELECT;
    PRINT "User lock segment is protected.";
    USL_SELECT:
    IF ( ! (SEC_UL[2]==1) ) THEN GOTO UEWL_SELECT;
    PRINT "FPGA array erase/write protected.";
    UEWL_SELECT:
    IF ( ! (SEC_UL[3]==1) ) THEN GOTO UVL_SELECT;
    PRINT "Fabric verify is protected.";
    UVL_SELECT:
    IF ( ! (SEC_UL[4]==1) ) THEN GOTO UPTL_SELECT;
    PRINT "User key 1/2 encrypted programming is enforced for the FPGA Array.";
    UPTL_SELECT:
    IF ( ! (SEC_UL[8]==1) ) THEN GOTO UL_JTAG_PROG_SELECT;
    PRINT "JTAG programming interface is protected.";
    UL_JTAG_PROG_SELECT:
    IF ( ! (SEC_UL[9]==1) ) THEN GOTO UL_SPI_PROG_SELECT;
    PRINT "SPI slave programming interface is protected.";
    UL_SPI_PROG_SELECT:
    IF ( ! (SEC_UL[11]==1) ) THEN GOTO USPL_SELECT;
    PRINT "User security is permanently locked.";
    USPL_SELECT:
    IF ( ! (SEC_UL[12]==1) ) THEN GOTO UL_E0_R_SELECT;
    PRINT "Debug read access to eNVM_0 is protected.";
    UL_E0_R_SELECT:
    IF ( ! (SEC_UL[17]==1) ) THEN GOTO UL_E0_PT_SELECT;
    PRINT "User key 1/2 encrypted programming is enforced for eNVM_0.";
    UL_E0_PT_SELECT:
    IF ( ! (SEC_UL[18]==1) ) THEN GOTO UL_PROG_SVC_ENABLE_SELECT;
    PRINT "IAP/ISP services are protected.";
    UL_PROG_SVC_ENABLE_SELECT:
    IF ( ! (SEC_UL[26]==1) ) THEN GOTO UL_EXTDIGEST_ENABLE_SELECT;
    PRINT "Digest requests from SPI/JTAG is protected.";
    UL_EXTDIGEST_ENABLE_SELECT:
    IF ( ! (SEC_UL[27]==1) ) THEN GOTO UL_REFLASH_ENABLE_SELECT;
    PRINT "Auto Programming is protected.";
    UL_REFLASH_ENABLE_SELECT:
    IF ( ! (SEC_UL[28]==1) ) THEN GOTO UL_BACKLEVEL_DISABLE_SELECT;
    PRINT "BACKLEVEL checking is enabled.";
    UL_BACKLEVEL_DISABLE_SELECT:
    IF ( ! (SEC_UL[29]==1) ) THEN GOTO UL_PLAINTEXT_KEY_ENABLE_SELECT;
    PRINT "Plaintext passkey match operations are disabled. Only the One Time Pass Key (OTPK) protocol can be used to match passkeys.";
    UL_PLAINTEXT_KEY_ENABLE_SELECT:
    IF ( ! (SEC_UL[41]==1) ) THEN GOTO UL_BUS_FIC_ESRAM0_R_SELECT;
    PRINT "Fabric access to eSRAM module 0 read is protected.";
    UL_BUS_FIC_ESRAM0_R_SELECT:
    IF ( ! (SEC_UL[42]==1) ) THEN GOTO UL_BUS_FIC_ESRAM0_W_SELECT;
    PRINT "Fabric access to eSRAM module 0 write is protected.";
    UL_BUS_FIC_ESRAM0_W_SELECT:
    IF ( ! (SEC_UL[43]==1) ) THEN GOTO UL_BUS_FIC_ESRAM1_R_SELECT;
    PRINT "Fabric access to eSRAM module 1 read is protected.";
    UL_BUS_FIC_ESRAM1_R_SELECT:
    IF ( ! (SEC_UL[44]==1) ) THEN GOTO UL_BUS_FIC_ESRAM1_W_SELECT;
    PRINT "Fabric access to eSRAM module 1 write is protected.";
    UL_BUS_FIC_ESRAM1_W_SELECT:
    IF ( ! (SEC_UL[45]==1) ) THEN GOTO UL_BUS_FIC_ENVM0_R_SELECT;
    PRINT "Fabric access to eNVM_0 read is protected.";
    UL_BUS_FIC_ENVM0_R_SELECT:
    IF ( ! (SEC_UL[46]==1) ) THEN GOTO UL_BUS_FIC_ENVM0_W_SELECT;
    PRINT "Fabric access to eNVM_0 write is protected.";
    UL_BUS_FIC_ENVM0_W_SELECT:
    IF ( ! (SEC_UL[49]==1) ) THEN GOTO UL_BUS_FIC_DDR_R_SELECT;
    PRINT "Fabric access to DDR bridge read is protected.";
    UL_BUS_FIC_DDR_R_SELECT:
    IF ( ! (SEC_UL[50]==1) ) THEN GOTO UL_BUS_FIC_DDR_W_SELECT;
    PRINT "Fabric access to DDR bridge write is protected.";
    UL_BUS_FIC_DDR_W_SELECT:
    IF ( ! (SEC_UL[51]==1) ) THEN GOTO UL_BUS_EXT_ESRAM0_R_SELECT;
    PRINT "External master access to eSRAM module 0 read is protected.";
    UL_BUS_EXT_ESRAM0_R_SELECT:
    IF ( ! (SEC_UL[52]==1) ) THEN GOTO UL_BUS_EXT_ESRAM0_W_SELECT;
    PRINT "External master access to eSRAM module 0 write is protected.";
    UL_BUS_EXT_ESRAM0_W_SELECT:
    IF ( ! (SEC_UL[53]==1) ) THEN GOTO UL_BUS_EXT_ESRAM1_R_SELECT;
    PRINT "External master access to eSRAM module 1 read is protected.";
    UL_BUS_EXT_ESRAM1_R_SELECT:
    IF ( ! (SEC_UL[54]==1) ) THEN GOTO UL_BUS_EXT_ESRAM1_W_SELECT;
    PRINT "External master access to eSRAM module 1 write is protected.";
    UL_BUS_EXT_ESRAM1_W_SELECT:
    IF ( ! (SEC_UL[55]==1) ) THEN GOTO UL_BUS_EXT_ENVM0_R_SELECT;
    PRINT "External master access to eNVM_0 read is protected.";
    UL_BUS_EXT_ENVM0_R_SELECT:
    IF ( ! (SEC_UL[56]==1) ) THEN GOTO UL_BUS_EXT_ENVM0_W_SELECT;
    PRINT "External master access to eNVM_0 write is protected.";
    UL_BUS_EXT_ENVM0_W_SELECT:
    IF ( ! (SEC_UL[59]==1) ) THEN GOTO UL_BUS_EXT_DDR_R_SELECT;
    PRINT "External master access to DDR bridge read is protected.";
    UL_BUS_EXT_DDR_R_SELECT:
    IF ( ! (SEC_UL[60]==1) ) THEN GOTO UL_BUS_EXT_DDR_W_SELECT;
    PRINT "External master access to DDR bridge write is protected.";
    UL_BUS_EXT_DDR_W_SELECT:
    IF ( ! (SEC_UL[72]==1) ) THEN GOTO UL_FAB_ALLOWED_L0_SELECT;
    PRINT "Fabric access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[73]==1) ) THEN GOTO UL_OTHERS_ALLOWED_L0_SELECT;
    PRINT "Other masters access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[74]==1) ) THEN GOTO UL_WRITE_ALLOWED_L0_SELECT;
    PRINT "Master write access to address range: 0x0000-0x0fff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_L0_SELECT:
    IF ( ! (SEC_UL[76]==1) ) THEN GOTO UL_FAB_ALLOWED_U0_SELECT;
    PRINT "Fabric access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[77]==1) ) THEN GOTO UL_OTHERS_ALLOWED_U0_SELECT;
    PRINT "Other masters access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[78]==1) ) THEN GOTO UL_WRITE_ALLOWED_U0_SELECT;
    PRINT "Master write access to address range: 0x3f000-0x3ffff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_U0_SELECT:
    IF ( ! (SEC_UL[80]==1) ) THEN GOTO UL_FAB_ALLOWED_L1_SELECT;
    PRINT "Fabric access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[81]==1) ) THEN GOTO UL_OTHERS_ALLOWED_L1_SELECT;
    PRINT "Other masters access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[82]==1) ) THEN GOTO UL_WRITE_ALLOWED_L1_SELECT;
    PRINT "Master write access to address range: 0x3e000-0x3efff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_L1_SELECT:
    IF ( ! (SEC_UL[84]==1) ) THEN GOTO UL_FAB_ALLOWED_U1_SELECT;
    PRINT "Fabric access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_FAB_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[85]==1) ) THEN GOTO UL_OTHERS_ALLOWED_U1_SELECT;
    PRINT "Other masters access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_OTHERS_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[86]==1) ) THEN GOTO UL_WRITE_ALLOWED_U1_SELECT;
    PRINT "Master write access to address range: 0x3d000-0x3dfff of eNVM_0 is protected.";
    UL_WRITE_ALLOWED_U1_SELECT:
    IF ( ! (SEC_UL[30]==1) ) THEN GOTO UL_AUTO_DIGEST_POR_SELECT;
    PRINT "Automatic digest check at power up is enabled.";
    IF ( ! ( (SEC_UCNFG[4]==1)&&(SEC_UL[10]==0)) ) THEN GOTO AUTODIGEST_FABRIC_SELECT;
    PRINT "FPGA array power on digest is enabled.";
    AUTODIGEST_FABRIC_SELECT:
    IF ( ! (SEC_UCNFG[5]==1) ) THEN GOTO AUTODIGEST_ENVM0_SELECT;
    PRINT "eNVM_0 power on digest is enabled.";
    AUTODIGEST_ENVM0_SELECT:
    LABEL_SEPARATOR = 0;
    UL_AUTO_DIGEST_POR_SELECT:
    IF ( ! ( (SEC_UCNFG[15]==0)&&(SEC_UCNFG[12]==0)) ) THEN GOTO IAPUPDATE_ENABLE_SELECT;
    PRINT "Programming recovery and auto-update are enabled.";
    IAPUPDATE_ENABLE_SELECT:
    IF ( ! ( (SEC_UCNFG[12]==0)&&(SEC_UCNFG[15]==1)) ) THEN GOTO IAPRECOVERY_ENABLE_SELECT;
    PRINT "Programming recovery is enabled.";
    IAPRECOVERY_ENABLE_SELECT:
    IF ( ! (SEC_UKL[0]==1) ) THEN GOTO UKSL_SELECT;
    PRINT "User Key Set 1 is erase/write protected.";
    UKSL_SELECT:
    IF ( ! (SEC_UKL[1]==1) ) THEN GOTO UKSVL_SELECT;
    PRINT "User Key Set 1 is verify protected.";
    UKSVL_SELECT:
    IF ( ! (SEC_VL[0]==1) ) THEN GOTO VSL_SELECT;
    PRINT "User Key Set 2 is erase/write protected.";
    VSL_SELECT:
    IF ( ! (SEC_VL[2]==1) ) THEN GOTO VSVL_SELECT;
    PRINT "User Key Set 2 is verify protected.";
    VSVL_SELECT:
    IF ( ! (SEC_VL[1]==1) ) THEN GOTO VSPL_SELECT;
    PRINT "User Key Set 2 is permanently locked.";
    VSPL_SELECT:
    IF ( ! ( (SEC_UL[7]==0)&&(SEC_VL[3]==0)) ) THEN GOTO ALLOW_FACTORY_TESTMODE_SELECT;
    PRINT "Factory test mode access is allowed.";
    ALLOW_FACTORY_TESTMODE_SELECT:
    IF ( ! ( (SEC_UL[7]==1)&&(SEC_VL[3]==0)) ) THEN GOTO PROTECT_FACTORY_TESTMODE_SELECT;
    PRINT "Factory test mode access is protected.";
    PROTECT_FACTORY_TESTMODE_SELECT:
    IF ( ! ( (SEC_UL[7]==1)&&(SEC_VL[3]==1)) ) THEN GOTO PERM_FACTORY_TESTMODE_SELECT;
    PRINT "Factory test mode access is permanently protected.";
    PERM_FACTORY_TESTMODE_SELECT:
    IF ( ! (INT(SEC_CCNFG[1..0])==0) ) THEN GOTO NOT_50US;
    PRINT "Power on reset delay: 50us";
    NOT_50US:
    IF ( ! (INT(SEC_CCNFG[1..0])==1) ) THEN GOTO NOT_1MS;
    PRINT "Power on reset delay: 1ms";
    NOT_1MS:
    IF ( ! (INT(SEC_CCNFG[1..0])==2) ) THEN GOTO NOT_10MS;
    PRINT "Power on reset delay: 10ms";
    NOT_10MS:
    IF ( ! (INT(SEC_CCNFG[1..0])==3) ) THEN GOTO NOT_100MS;
    PRINT "Power on reset delay: 100ms";
    NOT_100MS:
    IF ( ! (SEC_CCNFG[2]==1) ) THEN GOTO BG_AVM_DISABLE_SELECT;
    PRINT "System Controller Suspend Mode is disabled.";
    BG_AVM_DISABLE_SELECT:
    IF ( ! (SEC_CCNFG[2]==0) ) THEN GOTO BG_AVM_DISABLE_SELECT_ENABLED;
    PRINT "System Controller Suspend Mode is enabled.";
    BG_AVM_DISABLE_SELECT_ENABLED:
    IF ( ! (SEC_CCNFG[3]==0) ) THEN GOTO MODE1V_SELECT;
    PRINT "Operational Voltage: 1.2V";
    PRINT "Internal Oscillator: 50MHZ";
    MODE1V_SELECT:
    IF ( ! (SEC_CCNFG[3]==1) ) THEN GOTO MODE12V_SELECT;
    PRINT "Operational Voltage: 1.0V";
    PRINT "Internal Oscillator: 25MHZ";
    MODE12V_SELECT:
    IF ( ! (SEC_CL[0]==1) ) THEN GOTO OTPL_SELECT;
    PRINT "FPGA Array is one time programmable.";
    OTPL_SELECT:
    IF ( ! (SEC_DL[1]==1) ) THEN GOTO UDPWL_SELECT;
    PRINT "SmartDebug write access to Active Probe and AHB memory space is protected.";
    UDPWL_SELECT:
    IF ( ! (SEC_DL[2]==1) ) THEN GOTO UDPRL_SELECT;
    PRINT "SmartDebug read access to Active Probe, Live Probe, and AHB memory space is protected.";
    UDPRL_SELECT:
    IF ( ! (SEC_DL[3]==1) ) THEN GOTO ULUJ_SELECT;
    PRINT "UJTAG access to Fabric is protected.";
    ULUJ_SELECT:
    LABEL_SEPARATOR = 0;
    DO_NOT_QUERY_SEC:
    IF ( ! (SECURITY_QUERIED==0) ) THEN GOTO DUMP_SEC_CANNOTREAD;
    PRINT "Security locks and configuration settings cannot be read from the device.";
    PRINT "This could be because of debug locks, please use programming file with DPK.";
    DUMP_SEC_CANNOTREAD:
    PRINT "-------------------------------------------------";
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE SET_PGM_MODE USES GV,DO_EXIT;
    BOOLEAN MODE_RESULT[8];
    BOOLEAN MODE_VALUE[8] = $00;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $af;
    DRSCAN 8, MODE_VALUE[7..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE MODE_RESULT[7..0];
        IF ( ! (MODE_RESULT[7]==0) ) THEN GOTO MODE_POLL;
        IPOLL = 0;
        PASS = 1;
        MODE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO MODE_DONE;
        IRSCAN 8, $af;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        MODE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO MODE_PASSED;
    PRINT "Instruction timed out while configuring device programming at 1.2 VCC voltage. ";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    MODE_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE POLL_DEVICE_READY USES GV,DO_EXIT;
    PASS = 0;
    INTEGER ILOOP_0;
    FOR ILOOP_0 = 1000000 - 1 TO 0 STEP -1;
        IRSTOP IRPAUSE;
        DRSTOP DRPAUSE;
        IRSCAN 8, $8f;
        WAIT IDLE, 1 CYCLES;
        WAIT IDLE, 10 USEC;
        DRSCAN 8, $00,COMPARE $00,$80,PASS;
        IF PASS THEN ILOOP_0 = 0;
    NEXT ILOOP_0;
    IF ( ! (PASS==0) ) THEN GOTO DEVICE_READY;
    PRINT "Instruction timed out. Device is busy.";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    DEVICE_READY:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_SHARED_BUFFER USES GV,DO_EXIT;
    INTEGER IBLOCK =0;
    BOOLEAN BLOCKBUFFER[129];
    FOR IBLOCK = 0 TO (IBLOCKS-1) STEP 1;
        PASS = 0;
        BOOLEAN SHARED_BUFFER_RESULT[129];
        BLOCKBUFFER[6..1] = BOOL(IBLOCK);
        IRSTOP IRPAUSE;
        DRSTOP DRPAUSE;
        IRSCAN 8, $f2;
        DRSCAN 129, BLOCKBUFFER[];
        WAIT IDLE, 3 CYCLES;
        WAIT 10 USEC, DRPAUSE;
        FOR IPOLL = 27777 TO 0 STEP -1;
            DRSCAN 129, $000000000000000000000000000000000, CAPTURE SHARED_BUFFER_RESULT[];
            IF ( ! (SHARED_BUFFER_RESULT[128]==0) ) THEN GOTO READ_BUFFER_POLL;
            IPOLL = 0;
            PASS = 1;
            READ_BUFFER_POLL:
            IF ( ! (PASS==0) ) THEN GOTO READ_BUFFER_DONE;
            IRSCAN 8, $f2;
            WAIT IRPAUSE, 10 USEC, IRPAUSE;
            READ_BUFFER_DONE:
            LABEL_SEPARATOR = 0;
        NEXT IPOLL;
        IF ( ! (PASS==0) ) THEN GOTO READ_BUFFER_PASS;
        PRINT "Instruction timed out while reading design information.";
        STATUS = -32;
        UNIQUEEXITCODE = 32818;
        BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
        EXPORT "ERROR_CODE", BUFF32[15..0];
        CALL DO_EXIT;
        READ_BUFFER_PASS:
        SHARED_BUFFER[((128*IBLOCK)+127)..(128*IBLOCK)] = SHARED_BUFFER_RESULT[127..0];
    NEXT IBLOCK;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_QUERY_SECURITY USES GV,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN QUERY_SECURITY_RESULT[16];
    PASS = 0;
    SECURITY_QUERIED = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $b8;
    DRSCAN 16, $0000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 16, $0000, CAPTURE QUERY_SECURITY_RESULT[];
        IF ( ! (QUERY_SECURITY_RESULT[15]==0) ) THEN GOTO QUERY_SECURITY_POLL;
        IPOLL = 0;
        PASS = 1;
        QUERY_SECURITY_POLL:
        IF ( ! (PASS==0) ) THEN GOTO QUERY_SECURITY_DONE;
        IRSCAN 8, $b8;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        QUERY_SECURITY_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO QUERY_SECURITY_PASS;
    PRINT "Instruction timed out while querying security information.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    QUERY_SECURITY_PASS:
    IBLOCKS = 3;
    CALL READ_SHARED_BUFFER;
    FOR I = 0 TO 319 STEP 1;
        IF ( ! (SHARED_BUFFER[I]==1) ) THEN GOTO DO_QUERY_SECURITY_SUCCESS;
        SECURITY_QUERIED = 1;
        I = 320;
        DO_QUERY_SECURITY_SUCCESS:
        LABEL_SEPARATOR = 0;
    NEXT I;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_SECURITY USES GV,DO_QUERY_SECURITY;
    INTEGER BYTEIDX =0;
    CALL DO_QUERY_SECURITY;
    IF ( ! (SECURITY_QUERIED==0) ) THEN GOTO NOT_SEC_QUERY;
    PRINT "WARNING! Security cannot be read. This can be because of programmed debug lock. Please generate programming file with debug passkey provided.";
    NOT_SEC_QUERY:
    BYTEIDX = 0;
    SEC_UKL[5..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 1;
    SEC_UKL[11..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 2;
    SEC_VL[5..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 3;
    SEC_VL[11..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 4;
    SEC_UL[5..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 5;
    SEC_UL[11..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 6;
    SEC_UL[17..12] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 7;
    SEC_UL[23..18] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+2)];
    BYTEIDX = 8;
    SEC_CL[2..0] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_OPOK[2..0] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 9;
    SEC_CL[5..3] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_CCNFG[1..0] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+3)];
    SEC_OPOK[3] = SHARED_BUFFER[((BYTEIDX*8)+2)];
    BYTEIDX = 10;
    SEC_CL[8..6] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_CCNFG[4..2] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 11;
    SEC_CL[11..9] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_CCNFG[7..5] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 12;
    SEC_UL[26..24] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
