    SEC_UCNFG[6..4] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 25;
    SEC_UL[65..63] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[9..7] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 26;
    SEC_UL[68..66] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[12..10] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 27;
    SEC_UL[71..69] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
    SEC_UCNFG[15..13] = SHARED_BUFFER[((BYTEIDX*8)+4)..((BYTEIDX*8)+2)];
    BYTEIDX = 28;
    SEC_UL[74..72] = SHARED_BUFFER[((BYTEIDX*8)+7)..((BYTEIDX*8)+5)];
