    PRINT "Programming File Type:";
    UNDEF_P_F_T:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_UDV USES GV,DO_EXIT;
    BOOLEAN READ_UDV_RESULT[32];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $cd;
    DRSCAN 32, $00000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 100000 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE READ_UDV_RESULT[];
        IF ( ! (READ_UDV_RESULT[31]==0) ) THEN GOTO UDV_POLL;
        IPOLL = 0;
        PASS = 1;
        UDV_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_UDV_DONE;
        IRSCAN 8, $cd;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_UDV_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO UDV_PASS;
    PRINT "Instruction timed out while reading udv.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    UDV_PASS:
    PRINT "Die Firmware Version: ",INT(READ_UDV_RESULT[30..24]),".",INT(READ_UDV_RESULT[23..16]);
    EXPORT "UDV", READ_UDV_RESULT[31..0];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE FIX_INT_ARRAYS USES GV;
    INTEGER TEMP =0;
    IF ( ! (HEX[0]!=48) ) THEN GOTO NOT_48;
    FOR I = 0 TO 7;
        TEMP = HEX[I];
        HEX[I] = HEX[(15-I)];
        HEX[(15-I)] = TEMP;
    NEXT I;
    NOT_48:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_DESIGN_INFO USES GV,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN READ_DESIGN_INFO_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a6;
    DRSCAN 8, $00;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_DESIGN_INFO_RESULT[];
        IF ( ! (READ_DESIGN_INFO_RESULT[7]==0) ) THEN GOTO READ_DESIGN_INFO_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_DESIGN_INFO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_DESIGN_INFO_DONE;
        IRSCAN 8, $a6;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_DESIGN_INFO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_DESIGN_INFO_PASS;
    PRINT "Instruction timed out while reading design information.";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    READ_DESIGN_INFO_PASS:
    IBLOCKS = 3;
    CALL READ_SHARED_BUFFER;
    PRINT "Design Name: ",CHR$(INT(SHARED_BUFFER[23..16])),CHR$(INT(SHARED_BUFFER[31..24]))
        ,CHR$(INT(SHARED_BUFFER[39..32])),CHR$(INT(SHARED_BUFFER[47..40])),CHR$(INT(SHARED_BUFFER[55..48]))
        ,CHR$(INT(SHARED_BUFFER[63..56])),CHR$(INT(SHARED_BUFFER[71..64])),CHR$(INT(SHARED_BUFFER[79..72]))
        ,CHR$(INT(SHARED_BUFFER[87..80])),CHR$(INT(SHARED_BUFFER[95..88])),CHR$(INT(SHARED_BUFFER[103..96]))
        ,CHR$(INT(SHARED_BUFFER[111..104])),CHR$(INT(SHARED_BUFFER[119..112])),CHR$(INT(SHARED_BUFFER[127..120]))
        ,CHR$(INT(SHARED_BUFFER[135..128])),CHR$(INT(SHARED_BUFFER[143..136])),CHR$(INT(SHARED_BUFFER[151..144]))
        ,CHR$(INT(SHARED_BUFFER[159..152])),CHR$(INT(SHARED_BUFFER[167..160])),CHR$(INT(SHARED_BUFFER[175..168]))
        ,CHR$(INT(SHARED_BUFFER[183..176])),CHR$(INT(SHARED_BUFFER[191..184])),CHR$(INT(SHARED_BUFFER[199..192]))
        ,CHR$(INT(SHARED_BUFFER[207..200])),CHR$(INT(SHARED_BUFFER[215..208])),CHR$(INT(SHARED_BUFFER[223..216]))
        ,CHR$(INT(SHARED_BUFFER[231..224])),CHR$(INT(SHARED_BUFFER[239..232])),CHR$(INT(SHARED_BUFFER[247..240]))
        ,CHR$(INT(SHARED_BUFFER[255..248]));
    EXPORT "CHECKSUM", SHARED_BUFFER[15..0];
    EXPORT "READ_DESIGN_INFO: ", SHARED_BUFFER[271..0];
    EXPORT "DESIGNVER", SHARED_BUFFER[271..256];
    EXPORT "BACKLEVEL", SHARED_BUFFER[287..272];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_PROG_INFO USES GV,DO_EXIT;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $e7;
    DRSCAN 128, $00000000000000000000000000000000;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 128, $00000000000000000000000000000000, CAPTURE READ_PROG_INFO_RESULT[];
        IF ( ! (READ_PROG_INFO_RESULT[127]==0) ) THEN GOTO READ_PROG_INFO_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_PROG_INFO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_PROG_INFO_DONE;
        IRSCAN 8, $e7;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_PROG_INFO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_PROG_INFO_PASS;
    PRINT "Instruction timed out while reading programming information.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    READ_PROG_INFO_PASS:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY_ZEROIZATION_DIGEST USES GV,CONSTBLOCK,SHA256,SHA256_INIT,SHA256_UPDATE
    ,SHA256_FINAL,DO_EXIT,READ_SHARED_BUFFER;
    BOOLEAN FETCH_ZERO_INPUT[129] = $fffffffffffffffffffffffffffffffff;
    BOOLEAN FETCH_ZERO_OUTPUT[129];
    BOOLEAN FETCH_ZERO_MATCH;
    BOOLEAN FETCH_ZERO_FSN[64];
    BOOLEAN FETCH_ZERO_DIGEST[256];
    BOOLEAN FETCH_ZERO_VALIDATOR[32];
    BOOLEAN FETCH_ZERO_FABRICRAMZEROIZED;
    INTEGER FETCH_ZERO_I;
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $f5;
    DRSCAN 129, FETCH_ZERO_INPUT[128..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 129, $fffffffffffffffffffffffffffffffff, CAPTURE FETCH_ZERO_OUTPUT[128..0];
        IF ( ! (FETCH_ZERO_OUTPUT[128]==0) ) THEN GOTO FETCH_ZERO_POLL;
        IPOLL = 0;
        PASS = 1;
        FETCH_ZERO_POLL:
        IF ( ! (PASS==0) ) THEN GOTO FETCH_ZERO_DONE;
        IRSCAN 8, $f5;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        FETCH_ZERO_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO FETCH_ZERO_PASS1;
    PRINT "Instruction timed out while fetching zeroization result.";
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    STATUS = -32;
    CALL DO_EXIT;
    FETCH_ZERO_PASS1:
    IF ( ! (FETCH_ZERO_OUTPUT[0]==0) ) THEN GOTO FETCH_ZERO_DETECTED;
    PRINT "--- Previous zeroization results detected --- ";
    IBLOCKS = 5;
    CALL READ_SHARED_BUFFER;
    FETCH_ZERO_FSN[] = SHARED_BUFFER[63..0];
    FETCH_ZERO_DIGEST[] = SHARED_BUFFER[319..64];
    FETCH_ZERO_VALIDATOR[] = SHARED_BUFFER[72..41];
    FETCH_ZERO_FABRICRAMZEROIZED = FETCH_ZERO_OUTPUT[1];
    CALL SHA256_INIT;
    SHA256_UPDATE_DATA[447..192] = ZERO_10[255..0];
    SHA256_UPDATE_DATA[191..128] = FETCH_ZERO_FSN[63..0];
    SHA256_UPDATE_DATA[127..0] = $fffffffffffffffffffffffffffffffff;
    SHA256_UPDATE_DATA_SIZE = 448;
    CALL SHA256_UPDATE;
    CALL SHA256_FINAL;
    FETCH_ZERO_MATCH = 1;
    FOR FETCH_ZERO_I = 0 TO 255 STEP 1;
        IF ( ! (SHA256_HASH[FETCH_ZERO_I]!=FETCH_ZERO_DIGEST[FETCH_ZERO_I]) ) THEN GOTO FETCH_ZERO_CMPDG1;
        FETCH_ZERO_MATCH = 0;
        FETCH_ZERO_I = 255;
        FETCH_ZERO_CMPDG1:
        LABEL_SEPARATOR = 0;
    NEXT FETCH_ZERO_I;
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_MOD10;
    PRINT "Detected zeroization mode = 10 'like new'";
    FETCH_ZERO_MOD10:
    IF ( ! (FETCH_ZERO_MATCH==0) ) THEN GOTO FETCH_ZERO_MD0001;
    CALL SHA256_INIT;
    SHA256_UPDATE_DATA[447..192] = ZERO_00_01[255..0];
    SHA256_UPDATE_DATA[191..128] = FETCH_ZERO_FSN[63..0];
    SHA256_UPDATE_DATA[127..0] = $fffffffffffffffffffffffffffffffff;
    SHA256_UPDATE_DATA_SIZE = 448;
    CALL SHA256_UPDATE;
    CALL SHA256_FINAL;
    FETCH_ZERO_MATCH = 1;
    FOR FETCH_ZERO_I = 0 TO 255 STEP 1;
        IF ( ! (SHA256_HASH[FETCH_ZERO_I]!=FETCH_ZERO_DIGEST[FETCH_ZERO_I]) ) THEN GOTO FETCH_ZERO_CMPDG2;
        FETCH_ZERO_MATCH = 0;
        FETCH_ZERO_I = 255;
        FETCH_ZERO_CMPDG2:
        LABEL_SEPARATOR = 0;
    NEXT FETCH_ZERO_I;
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_0001MATCH;
    PRINT "Detected zeroization mode = 01 'recoverable' or 00 'non-recoverable'";
    FETCH_ZERO_0001MATCH:
    LABEL_SEPARATOR = 0;
    FETCH_ZERO_MD0001:
    IF ( ! (FETCH_ZERO_MATCH==1) ) THEN GOTO FETCH_ZERO_VEROK;
    PRINT "Zeroization digest has been verified";
    FETCH_ZERO_VEROK:
    IF ( ! (FETCH_ZERO_MATCH==0) ) THEN GOTO FETCH_ZERO_VERERR;
    PRINT "***Zeroization digest failed verification";
    FETCH_ZERO_VERERR:
    EXPORT "Zeroization data", SHARED_BUFFER[319..0];
    PRINT "---------------------------------------------";
    FETCH_ZERO_DETECTED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_READ_DIGEST USES GV,DO_EXIT,READ_SHARED_BUFFER;
    IF ( ! (SEC_UL[26]==1) ) THEN GOTO UL_EXTDIGEST_ENABLE_DIGEST;
    PRINT "Digest requests from SPI/JTAG is protected by user pass key 1";
    CALL DO_EXIT;
    UL_EXTDIGEST_ENABLE_DIGEST:
    BOOLEAN READ_DIGESTS_RESULT[8];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $a3;
    DRSCAN 8, $00;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 8, $00, CAPTURE READ_DIGESTS_RESULT[7..0];
        IF ( ! (READ_DIGESTS_RESULT[7]==0) ) THEN GOTO READ_DIGESTS_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_DIGESTS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_DIGESTS_DONE;
        IRSCAN 8, $a3;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_DIGESTS_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IBLOCKS = 6;
    CALL READ_SHARED_BUFFER;
    EXPORT "Fabric digest: ", SHARED_BUFFER[255..0];
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_VERIFY_DIGEST USES GV,DO_EXIT;
    BOOLEAN CHECK_DIGESTS_RESULT[16];
    BOOLEAN CHECK_DIGESTS_INPUT[16];
    PASS = 0;
    INTEGER DIGEST_ERROR =0;
    CHECK_DIGESTS_INPUT[0] = 1;
    CHECK_DIGESTS_INPUT[13..10] = BOOL(15);
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $bc;
    DRSCAN 16, CHECK_DIGESTS_INPUT[15..0];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 1000000 TO 0 STEP -1;
        DRSCAN 16, $0000, CAPTURE CHECK_DIGESTS_RESULT[15..0];
        IF ( ! (CHECK_DIGESTS_RESULT[15]==0) ) THEN GOTO CHECK_DIGESTS_POLL;
        IPOLL = 0;
        PASS = 1;
        CHECK_DIGESTS_POLL:
        IF ( ! (PASS==0) ) THEN GOTO CHECK_DIGESTS_DONE;
        IRSCAN 8, $bc;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        CHECK_DIGESTS_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO CHECK_DIGESTS_PASS1;
    PRINT "Instruction timed out while verifying digest.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    CHECK_DIGESTS_PASS1:
    IF ( ! (INT(CHECK_DIGESTS_INPUT[13..10])==INT(CHECK_DIGESTS_RESULT[13..10])) ) THEN GOTO UL_EXTDIGEST_NOT_ENABLED;
    PRINT "Digest request from SPI/JTAG is protected by user pass key 1.";
    STATUS = -18;
    UNIQUEEXITCODE = 32787;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    UL_EXTDIGEST_NOT_ENABLED:
    IF ( ! ( (PASS==1)&&(CHECK_DIGESTS_RESULT[14]==1)) ) THEN GOTO CHECK_DIGESTS_PASS3;
    PRINT "Failed while running verify digest.";
    STATUS = -19;
    UNIQUEEXITCODE = 32788;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    CALL DO_EXIT;
    CHECK_DIGESTS_PASS3:
    IF ( ! (CHECK_DIGESTS_RESULT[0]==1) ) THEN GOTO FABRIC_DIGEST_FAIL;
    PRINT "FPGA Fabric digest verification: PASS";
    FABRIC_DIGEST_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[0]==0) ) THEN GOTO FABRIC_DIGEST_PASS;
    PRINT "FPGA Fabric digest verification: FAIL";
    UNIQUEEXITCODE = 32789;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FABRIC_DIGEST_PASS:
    IF ( ! (CHECK_DIGESTS_RESULT[6]==0) ) THEN GOTO FACTORY_PASS;
    PRINT "Factory row and factory key digest verification: FAIL";
    UNIQUEEXITCODE = 32795;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FACTORY_PASS:
    IF ( ! (CHECK_DIGESTS_RESULT[7]==1) ) THEN GOTO FABRIC_CONFIG_FAIL;
    PRINT "Fabric configuration digest verification: PASS";
    FABRIC_CONFIG_FAIL:
    IF ( ! (CHECK_DIGESTS_RESULT[7]==0) ) THEN GOTO FABRIC_CONFIG_PASS;
    PRINT "Fabric configuration digest verification: FAIL";
    UNIQUEEXITCODE = 32796;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    DIGEST_ERROR = 1;
    FABRIC_CONFIG_PASS:
    IF ( ! (DIGEST_ERROR==1) ) THEN GOTO ALL_DIGEST_PASSED;
    STATUS = -20;
    ALL_DIGEST_PASSED:
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_DEVICE_INFO USES GV,READ_FSN,DO_EXIT,DUMP_SECURITY_INFO,DO_READ_SECURITY
    ,PRINT_IDCODE,DUMP_PROG_INFO,DO_READ_UDV,DO_READ_DESIGN_INFO,DO_READ_PROG_INFO
    ,DO_VERIFY_ZEROIZATION_DIGEST,DO_READ_DIGEST;
    CALL PRINT_IDCODE;
    PRINT "Die Revision: ",IDREV;
    CALL DO_READ_UDV;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $0e;
    WAIT IDLE, 1 CYCLES;
    DRSCAN 32, $00000000, CAPTURE BUFF32[];
    IF ( ! (INT(BUFF32[31..0])==-1) ) THEN GOTO NOT_EMPTY_SILSIG;
    BUFF32[31..0] = $00000000;
    NOT_EMPTY_SILSIG:
    EXPORT "SILSIG", BUFF32[];
    IRSCAN 8, $8f, CAPTURE BUFF32[7..0];
    IF ( ! (BUFF32[2]==1) ) THEN GOTO CORE_NOT_ENABLED;
    PRINT "FPGA Array is programmed and enabled.";
    CORE_NOT_ENABLED:
    IF ( ! (BUFF32[2]==0) ) THEN GOTO CORE_ENABLED;
    PRINT "FPGA Array is not enabled.";
    CORE_ENABLED:
    CALL DO_VERIFY_ZEROIZATION_DIGEST;
    CALL DO_READ_DESIGN_INFO;
    CALL DO_READ_PROG_INFO;
    CALL DUMP_PROG_INFO;
    CALL READ_FSN;
    IF ( ! (READ_FSN_RESULT[128]==1) ) THEN GOTO FSN_NOT_BUSY;
    CALL DO_EXIT;
    FSN_NOT_BUSY:
    CALL DO_READ_DIGEST;
    CALL DO_READ_SECURITY;
    CALL DUMP_SECURITY_INFO;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_CHECK_CYCLE_COUNT USES GV,DO_READ_PROG_INFO;
    INTEGER CYCLECOUNT =0;
    INTEGER MAXCYCLECOUNT =500;
    CALL DO_READ_PROG_INFO;
    CYCLECOUNT = INT(READ_PROG_INFO_RESULT[15..0]);
    IF ( ! (CYCLECOUNT!=65535) ) THEN GOTO UNKNOWN_CYCLE_COUNT2;
    IF ( ! ( (CYCLECOUNT>=(MAXCYCLECOUNT-50))&&(CYCLECOUNT<MAXCYCLECOUNT)) ) THEN GOTO NOT_LAST_CYCLE_COUNT;
    PRINT "Info: You are ",(MAXCYCLECOUNT-CYCLECOUNT)," cycles away from maximum programming cycle count of "
        ,MAXCYCLECOUNT," on this device. Refer to your device datasheet for more details.";
    NOT_LAST_CYCLE_COUNT:
    IF ( ! (CYCLECOUNT==MAXCYCLECOUNT) ) THEN GOTO WARN_CYCLE_COUNT;
    PRINT "Info: You are in the last cycle to reach maximum programming cycle count of "
        ,MAXCYCLECOUNT," on this device. Refer to your device datasheet for more details.";
    WARN_CYCLE_COUNT:
    IF ( ! (CYCLECOUNT>MAXCYCLECOUNT) ) THEN GOTO NO_WARN_CYCLE_COUNT;
    PRINT "Warning: You have exceeded the maximum programming cycle count of ",MAXCYCLECOUNT
        ," on this device. Refer to your device datasheet for more details.";
    NO_WARN_CYCLE_COUNT:
    LABEL_SEPARATOR = 0;
    UNKNOWN_CYCLE_COUNT2:
    LABEL_SEPARATOR = 0;
ENDPROC;


CRC 775A;
