    PRINT "Software Version: 11.8";
    NOT_11_8:
    IF ( ! (TMPINT==FP_11_9) ) THEN GOTO NOT_FP_11_9;
    PRINT "Software Version: 11.9";
    NOT_FP_11_9:
    IF ( ! (TMPINT==FP_12_0) ) THEN GOTO NOT_FP_12_0;
