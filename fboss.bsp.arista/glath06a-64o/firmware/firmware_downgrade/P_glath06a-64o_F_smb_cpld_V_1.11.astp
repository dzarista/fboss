ENDPROC;

PROCEDURE EXPORT_CERTIFICATES USES GV;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_FSN USES GV;
    PASS = 0;
    READ_FSN_RESULT[128..0] = $000000000000000000000000000000000;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $f0;
    DRSCAN 129, READ_FSN_RESULT[];
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 129, $000000000000000000000000000000000, CAPTURE READ_FSN_RESULT[];
        IF ( ! (READ_FSN_RESULT[128]==0) ) THEN GOTO READ_FSN_POLL;
        IPOLL = 0;
        PASS = 1;
        READ_FSN_POLL:
        IF ( ! (PASS==0) ) THEN GOTO READ_FSN_DONE;
        IRSCAN 8, $f0;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        READ_FSN_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO READ_FSN_COMPLETE;
    PRINT "Failed to read DSN.";
    STATUS = -24;
    UNIQUEEXITCODE = 32769;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    READ_FSN_COMPLETE:
    DSN[127..0] = READ_FSN_RESULT[127..0];
    IF ( ! (DUMPDSN==1) ) THEN GOTO DONT_DUMP_DSN;
    PRINT "===================================================================================";
    EXPORT "DSN", READ_FSN_RESULT[127..0];
    PRINT "===================================================================================";
    DONT_DUMP_DSN:
    DUMPDSN = 1;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE DO_EXIT USES GV,CONSTBLOCK,EXPORT_CERTIFICATES,READ_FSN;
    IF ( ! (BPGMMODE==1) ) THEN GOTO SKIP_ISC_DISABLE;
    BOOLEAN ISC_DISABLE_RESULT[32];
    PASS = 0;
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $81;
    WAIT IDLE, 3 CYCLES;
    WAIT 10 USEC, DRPAUSE;
    FOR IPOLL = 27777 TO 0 STEP -1;
        DRSCAN 32, $00000000, CAPTURE ISC_DISABLE_RESULT[31..0];
        IF ( ! (ISC_DISABLE_RESULT[31]==0) ) THEN GOTO ISC_DISABLE_POLL;
        IPOLL = 0;
        PASS = 1;
        ISC_DISABLE_POLL:
        IF ( ! (PASS==0) ) THEN GOTO ISC_DISABLE_DONE;
        IRSCAN 8, $81;
        WAIT IRPAUSE, 10 USEC, IRPAUSE;
        ISC_DISABLE_DONE:
        LABEL_SEPARATOR = 0;
    NEXT IPOLL;
    IF ( ! (PASS==0) ) THEN GOTO ISC_DISABLE_PASS;
    PRINT "Instruction timed out while disabling programming mode.";
    STATUS = -32;
    UNIQUEEXITCODE = 32818;
    BUFF32[15..0] = BOOL(UNIQUEEXITCODE);
    EXPORT "ERROR_CODE", BUFF32[15..0];
    ISC_DISABLE_PASS:
    IRSTOP IRPAUSE;
    DRSTOP DRPAUSE;
    IRSCAN 8, $09;
    WAIT IDLE, 1 CYCLES;
    WAIT IDLE, 1000 USEC;
    SKIP_ISC_DISABLE:
    CALL READ_FSN;
    WAIT RESET, 5 CYCLES;
    IF ( ! ( (ACTIONTYPE!=ACTION_NONE)&&(STATUS==0)) ) THEN GOTO DONT_EXPORT_COFC;
    CALL EXPORT_CERTIFICATES;
    DONT_EXPORT_COFC:
    EXIT STATUS;
    LABEL_SEPARATOR = 0;
ENDPROC;

PROCEDURE READ_DSN_WITHOUT_DUMP USES GV,READ_FSN,DO_EXIT;
    DUMPDSN = 0;
    CALL READ_FSN;
    IF ( ! (READ_FSN_RESULT[128]==1) ) THEN GOTO DSN_NOT_BUSY2;
    CALL DO_EXIT;
    DSN_NOT_BUSY2:
    DSN[127..0] = READ_FSN_RESULT[127..0];
    DUMPDSN = 1;
ENDPROC;

PROCEDURE LOAD_AUXLO USES GV,DO_EXIT;
