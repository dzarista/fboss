diff -Naur original/jp_25/Makefile jp_25/Makefile
--- original/jp_25/Makefile	1970-01-01 00:00:00.000000000 +0000
+++ jp_25/Makefile	2025-10-24 16:26:22.144876883 +0000
@@ -0,0 +1,22 @@
+VERSION := 0.0.1
+
+TARGET_EXEC := jam
+
+BUILD_DIR := ./build
+SRC_DIRS := ./source
+
+SRCS := $(shell find $(SRC_DIRS) -name '*.c')
+OBJS := $(SRCS:%=$(BUILD_DIR)/%.o)
+
+CFLAGS := -O2
+
+$(BUILD_DIR)/$(TARGET_EXEC): $(OBJS)
+	$(CC) $(OBJS) -o $@ $(LDFLAGS)
+
+$(BUILD_DIR)/%.c.o: %.c
+	mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -c $< -o $@
+
+.PHONY: clean
+clean:
+	rm -rf $(BUILD_DIR)
