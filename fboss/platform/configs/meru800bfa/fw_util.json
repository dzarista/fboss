{
  "fwConfigs" : {
    "bios" : {
      "preUpgradeCmd" : "printf '3000000:3FFFFFF image' > /home/bios_spi_layout",
      "priority" : 1,
      "upgradeCmd" : "bios_filename=$(head -n 1 /home/bios_filename.txt); flashrom -p internal -l /home/bios_spi_layout -i image --noverify-all -w $bios_filename",
      "postUpgradeCmd" : "bios_filename=$(head -n 1 /home/bios_filename.txt); flashrom -p internal -l /home/bios_spi_layout -i image --noverify-all -v $bios_filename",
      "verifyFwCmd" : "bios_filename=$(head -n 1 /home/bios_filename.txt); flashrom -p internal -l /home/bios_spi_layout -i image --noverify-all -v $bios_filename",
      "readFwCmd" : "bios_filename=$(head -n 1 /home/bios_filename.txt); flashrom -p internal -l /home/bios_spi_layout -i image --noverify-all -r $bios_filename"
    },
    "meru_scm_cpld" : {
      "preUpgradeCmd" : "",
      "getVersionCmd" : "cpu_cpld_ver=$((`cat /run/devmap/fpgas/MERU_SCM_CPLD/fpga_ver`));cpu_cpld_subver=$((`cat /run/devmap/fpgas/MERU_SCM_CPLD/fpga_sub_ver`));echo $cpu_cpld_ver'.'$cpu_cpld_subver",
      "priority" : 2,
      "upgradeCmd" : "cpu_cpld_filename=$(head -n 1 /home/meru_scm_cpld_filename.txt);/usr/bin/jam -aprogram -fmeru_cpu_cpld -v $cpu_cpld_filename",
      "postUpgradeCmd" : ""
    },
    "meru_smb_cpld" : {
      "preUpgradeCmd" : "echo 1 > /run/devmap/fpgas/MERU_SCM_CPLD/switch_jtag_enable",
      "getVersionCmd" : "smb_cpld_ver=$((`head -1 /run/devmap/cplds/MERU800BFA_SMB_CPLD/cpld_ver`));smb_cpld_subver=$((`head -1 /run/devmap/cplds/MERU800BFA_SMB_CPLD/cpld_sub_ver`));echo $smb_cpld_ver'.'$smb_cpld_subver",
      "priority" : 3,
      "upgradeCmd" : "smb_cpld_filename=$(head -n 1 /home/meru_smb_cpld_filename.txt);/usr/bin/jam -aprogram -fmeru_switch_cpld -v $smb_cpld_filename",
      "postUpgradeCmd" : "echo 0 > /run/devmap/fpgas/MERU_SCM_CPLD/switch_jtag_enable"
    },
    "meru_smb_fpga0" : {
      "preUpgradeCmd" : "",
      "getVersionCmd" : "smb_fpga0_ver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA0/fpga_ver`));smb_fpga0_subver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA0/fpga_sub_ver`));echo $smb_fpga0_ver'.'$smb_fpga0_subver",
      "priority" : 4,
      "upgradeCmd" : "smb_fpga0_filename=$(head -n 1 /home/meru_smb_fpga0_filename.txt);fpga0_mtd_dev=$(grep $(ls /run/devmap/fpgas/MERU800BFA_SMB_FPGA0/scd-spi*/spi_master/spi* | grep spi*.*) /proc/mtd |awk '{print$1}' | tr -d : | tr -d mtd);flashrom -p linux_mtd:dev=$fpga0_mtd_dev -w $smb_fpga0_filename",
      "postUpgradeCmd" : ""
    },
    "meru_smb_fpga1" : {
      "preUpgradeCmd" : "",
      "getVersionCmd" : "smb_fpga1_ver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA1/fpga_ver`));smb_fpga1_subver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA1/fpga_sub_ver`));echo $smb_fpga1_ver'.'$smb_fpga1_subver",
      "priority" : 4,
      "upgradeCmd" : "smb_fpga1_filename=$(head -n 1 /home/meru_smb_fpga1_filename.txt);fpga1_mtd_dev=$(grep $(ls /run/devmap/fpgas/MERU800BFA_SMB_FPGA1/scd-spi*/spi_master/spi* | grep spi*.*) /proc/mtd |awk '{print$1}' | tr -d : | tr -d mtd);flashrom -p linux_mtd:dev=$fpga1_mtd_dev -w $smb_fpga1_filename",
      "postUpgradeCmd" : ""
    },
    "meru_smb_fpga2" : {
      "preUpgradeCmd" : "",
      "getVersionCmd" : "smb_fpga2_ver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA2/fpga_ver`));smb_fpga2_subver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA2/fpga_sub_ver`));echo $smb_fpga2_ver'.'$smb_fpga2_subver",
      "priority" : 4,
      "upgradeCmd" : "smb_fpga2_filename=$(head -n 1 /home/meru_smb_fpga2_filename.txt);fpga2_mtd_dev=$(grep $(ls /run/devmap/fpgas/MERU800BFA_SMB_FPGA2/scd-spi*/spi_master/spi* | grep spi*.*) /proc/mtd |awk '{print$1}' | tr -d : | tr -d mtd);flashrom -p linux_mtd:dev=$fpga2_mtd_dev -w $smb_fpga2_filename",
      "postUpgradeCmd" : ""
    },
    "meru_smb_fpga3" : {
      "preUpgradeCmd" : "",
      "getVersionCmd" : "smb_fpga3_ver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA3/fpga_ver`));smb_fpga3_subver=$((`cat /run/devmap/fpgas/MERU800BFA_SMB_FPGA3/fpga_sub_ver`));echo $smb_fpga3_ver'.'$smb_fpga3_subver",
      "priority" : 4,
      "upgradeCmd" : "smb_fpga3_filename=$(head -n 1 /home/meru_smb_fpga3_filename.txt);fpga3_mtd_dev=$(grep $(ls /run/devmap/fpgas/MERU800BFA_SMB_FPGA3/scd-spi*/spi_master/spi* | grep spi*.*) /proc/mtd |awk '{print$1}' | tr -d : | tr -d mtd);flashrom -p linux_mtd:dev=$fpga3_mtd_dev -w $smb_fpga3_filename",
      "postUpgradeCmd" : ""
    }
  }
}
