    PRINT "Programmer:";
    UNDEF_P_T:
    TMPINT = INT(BUFF32[22..17]);
    IF ( ! (TMPINT==FP34) ) THEN GOTO NOT_FP34;
    PRINT "Software Version: FlashPro v3.4";
    NOT_FP34:
    IF ( ! (TMPINT==FP40) ) THEN GOTO NOT_FP40;
    PRINT "Software Version: FlashPro v4.0";
    NOT_FP40:
