    INTEGER SHA256_RSHIFT_Y;
    INTEGER SHA256_RSHIFT_RES;
    INTEGER SHA256_UADD_X;
    INTEGER SHA256_UADD_Y;
    INTEGER SHA256_UADD_RES;
    INTEGER SHA256_K[64] = 1116352408,1899447441,-1245643825,-373957723,961987163
